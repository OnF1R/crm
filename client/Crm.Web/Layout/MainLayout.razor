@inherits LayoutComponentBase
@using Crm.Web.Services
@using Crm.Web.Auth

<div class="flex h-screen bg-surface-50">
    @if (authState.IsAuthenticated)
    {
        <nav class="w-60 min-w-[240px] bg-surface-900 text-white flex flex-col">
            <div class="p-5 border-b border-white/10">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
                    </div>
                    <div>
                        <h1 class="text-sm font-bold tracking-tight">CRM</h1>
                        <p class="text-[10px] text-surface-400 -mt-0.5">Система</p>
                    </div>
                </div>
            </div>

            <div class="flex-1 py-3 overflow-y-auto scrollbar-thin">
                <div class="px-3 mb-2"><span class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider">Меню</span></div>

                <NavLink class="block mb-0.5" href="dashboard" Match="NavLinkMatch.All">
                    <div class="flex items-center gap-3 px-3 py-2 mx-2 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V9.75zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>
                        <span class="text-sm">Дашборд</span>
                    </div>
                </NavLink>

                <NavLink class="block mb-0.5" href="clients">
                    <div class="flex items-center gap-3 px-3 py-2 mx-2 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                        <span class="text-sm">Клиенты</span>
                    </div>
                </NavLink>

                <NavLink class="block mb-0.5" href="deals">
                    <div class="flex items-center gap-3 px-3 py-2 mx-2 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.35c0 .621-.504 1.125-1.125 1.125H4.875c-.621 0-1.125-.504-1.125-1.125v-4.35m16.5 0V9.15m0 5.25H3.75m16.5 0H3.75m0 0V9.15m0 5.25c0-.621.504-1.125 1.125-1.125h16.5c.621 0 1.125.504 1.125 1.125V9.15m-18 0L5.25 3.75h13.5l2.25 5.4"/></svg>
                        <span class="text-sm">Сделки</span>
                    </div>
                </NavLink>

                <NavLink class="block mb-0.5" href="tasks">
                    <div class="flex items-center gap-3 px-3 py-2 mx-2 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-2.485-.036H6.598a48.42 48.42 0 00-2.485.036c-1.131.094-1.976 1.057-1.976 2.192V16.5A2.25 2.25 0 004.5 18.75h3"/></svg>
                        <span class="text-sm">Задачи</span>
                    </div>
                </NavLink>

                <NavLink class="block mb-0.5" href="notifications">
                    <div class="flex items-center gap-3 px-3 py-2 mx-2 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5M12 3a5.25 5.25 0 015.25 5.25c0 3.75 1.5 6 3 7.5H3.75c1.5-1.5 3-3.75 3-7.5A5.25 5.25 0 0112 3zM8.25 18.75h7.5M10.5 21h3"/></svg>
                        <span class="text-sm">Уведомления</span>
                        @if (unreadCount > 0)
                        {
                            <span class="ml-auto px-1.5 py-0.5 text-[10px] font-medium bg-danger-500 text-white rounded-full leading-none">@unreadCount</span>
                        }
                    </div>
                </NavLink>

                <div class="px-3 mt-4 mb-2"><span class="text-[10px] font-semibold text-surface-500 uppercase tracking-wider">Ресурсы</span></div>

                <NavLink class="block mb-0.5" href="documents">
                    <div class="flex items-center gap-3 px-3 py-2 mx-2 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                        <span class="text-sm">Документы</span>
                    </div>
                </NavLink>

                <NavLink class="block mb-0.5" href="analytics">
                    <div class="flex items-center gap-3 px-3 py-2 mx-2 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-[18px] h-[18px] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"/></svg>
                        <span class="text-sm">Аналитика</span>
                    </div>
                </NavLink>
            </div>

            <div class="p-3 border-t border-white/10">
                <div class="flex items-center gap-3 px-2 py-2">
                    <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center text-xs font-bold flex-shrink-0">
                        @(authState.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-white truncate">@authState.User?.FullName</p>
                        <p class="text-[10px] text-surface-500 truncate">@authState.User?.Email</p>
                    </div>
                </div>
                <button @onclick="Logout" class="w-full mt-2 px-3 py-1.5 rounded-lg text-surface-400 hover:bg-white/5 hover:text-white text-xs transition-all duration-200 flex items-center justify-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
                    Выйти
                </button>
            </div>
        </nav>
    }

    <main class="flex-1 overflow-auto">
        @if (authState.IsAuthenticated)
        {
            <div class="max-w-7xl mx-auto px-6 py-6 animate-fade-in">
                @Body
            </div>
        }
        else
        {
            @Body
        }
    </main>
</div>

@code {
    [Inject] private AuthState authState { get; set; } = default!;
    [Inject] private AuthService authService { get; set; } = default!;
    [Inject] private ApiClient Api { get; set; } = default!;

    private int unreadCount;

    private void Logout() => authService.Logout();

    protected override async Task OnInitializedAsync()
    {
        authState.OnChange += OnAuthStateChanged;
        await LoadUnreadCount();
    }

    private async Task LoadUnreadCount()
    {
        if (!authState.IsAuthenticated) return;
        try
        {
            var userId = authState.User?.Id ?? Guid.Empty;
            if (userId != Guid.Empty)
            {
                var result = await Api.GetAsync<UnreadCountDto>($"/api/notifications/users/{userId}/notifications/unread-count");
                if (result != null) unreadCount = result.Count;
            }
        }
        catch { }
    }

    private async void OnAuthStateChanged()
    {
        await LoadUnreadCount();
        await InvokeAsync(StateHasChanged);
    }

    private record UnreadCountDto(int Count);
}
