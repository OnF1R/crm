@page "/tasks"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Задачи - CRM</PageTitle>

<div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Задачи</h1>
            <p class="text-sm text-gray-400 mt-0.5">Управление задачами</p>
        </div>
        <button @onclick="OpenCreateForm" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-medium transition-all shadow-sm hover:shadow-md">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Новая задача
        </button>
    </div>

    <div class="flex gap-2 mb-6">
        @foreach (var col in statusColumns)
        {
            var count = tasks.Count(t => GetStatusInt(t.Status) == col.Value);
            var isActive = statusFilter == col.Value.ToString();
            <button @onclick="() => ToggleFunnelFilter(col.Value)"
                    class="flex-1 py-3 rounded-xl text-center transition-all duration-200 @(isActive ? col.ActiveClass : col.InactiveClass)">
                <div class="text-xs font-medium">@col.Label</div>
                <div class="text-lg font-bold mt-0.5">@count</div>
            </button>
        }
    </div>

    <div class="mb-6 flex flex-wrap gap-3 items-center">
        <div class="relative flex-1 min-w-[200px] max-w-md">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input @bind="searchQuery" @bind:event="oninput" placeholder="Поиск по названию..." class="w-full pl-10 pr-4 py-2.5 bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] focus:ring-2 focus:ring-blue-500 text-sm placeholder-gray-400 border-0" />
        </div>
        <select @bind="priorityFilter" class="px-3 py-2.5 bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] focus:ring-2 focus:ring-blue-500 text-sm text-gray-600 border-0">
            <option value="">Все приоритеты</option>
            <option value="1">Низкий</option>
            <option value="2">Средний</option>
            <option value="3">Высокий</option>
            <option value="4">Критический</option>
        </select>
        <select @bind="clientFilter" class="px-3 py-2.5 bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] focus:ring-2 focus:ring-blue-500 text-sm text-gray-600 border-0">
            <option value="">Все клиенты</option>
            @foreach (var c in availableClients)
            {
                <option value="@c.Id">@c.CompanyName</option>
            }
        </select>
    </div>

    @if (showForm)
    {
        <div class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center z-50" @onclick="CloseForm">
            <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-bold text-gray-900">@(editingId == null ? "Новая задача" : "Редактирование задачи")</h2>
                    <button @onclick="CloseForm" class="p-1.5 hover:bg-gray-100 rounded-lg transition">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Название *</label>
                        <input @bind="form.Title" class="w-full px-4 py-2.5 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Подготовить КП" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Описание</label>
                        <textarea @bind="form.Description" rows="3" class="w-full px-4 py-2.5 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm resize-none" placeholder="Детали задачи"></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Приоритет</label>
                            <select @bind="form.Priority" class="w-full px-4 py-2.5 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm">
                                <option value="1">Низкий</option>
                                <option value="2">Средний</option>
                                <option value="3">Высокий</option>
                                <option value="4">Критический</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Клиент</label>
                            <select @bind="form.ClientId" class="w-full px-4 py-2.5 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm">
                                <option value="">-- Без клиента --</option>
                                @foreach (var c in availableClients)
                                {
                                    <option value="@c.Id">@c.CompanyName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Срок</label>
                        <input @bind="form.DueDate" @bind:format="yyyy-MM-dd" type="date" class="w-full px-4 py-2.5 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm" />
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="px-4 py-3 bg-red-50 text-red-600 text-sm rounded-xl">@formError</div>
                    }
                    <div class="flex justify-end gap-3 pt-2">
                        <button @onclick="CloseForm" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl font-medium transition">Отмена</button>
                        <button @onclick="SaveTask" disabled="@isSubmitting" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-medium transition disabled:opacity-50">
                            @(isSubmitting ? "Сохранение..." : (editingId == null ? "Создать" : "Сохранить"))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-20">
            <div class="inline-flex items-center gap-2 text-gray-400">
                <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                Загрузка...
            </div>
        </div>
    }
    else if (filteredTasks.Any())
    {
        <div class="space-y-3">
            @foreach (var task in filteredTasks)
            {
                <div class="bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] p-4 hover:shadow-[0_2px_8px_rgba(0,0,0,0.08),0_8px_24px_rgba(0,0,0,0.06)] transition-all duration-200">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-start gap-3 flex-1 min-w-0">
                            <span class="w-2.5 h-2.5 rounded-full @GetPriorityDotColor(task.Priority) mt-1.5 flex-shrink-0"></span>
                            <div class="flex-1 min-w-0">
                                <NavLink href="@($"tasks/{task.Id}")" class="font-medium text-gray-900 hover:text-blue-600 transition">@task.Title</NavLink>
                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <p class="text-sm text-gray-400 mt-1 truncate">@task.Description</p>
                                }
                            </div>
                        </div>
                        <div class="flex items-center gap-3 flex-shrink-0">
                            <span class="px-3 py-1 text-xs font-medium rounded-full @GetStatusColor(task.Status)">@GetStatusName(task.Status)</span>
                            @if (task.RelatedEntityType == "Client" && task.RelatedEntityId.HasValue)
                            {
                                var clientName = availableClients.FirstOrDefault(c => c.Id == task.RelatedEntityId.Value)?.CompanyName;
                                <span class="text-xs text-gray-500 bg-gray-50 px-2.5 py-1 rounded-lg">@(clientName ?? "Клиент")</span>
                            }
                            @if (task.DueDate.HasValue)
                            {
                                <span class="text-xs text-gray-400 flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    @task.DueDate.Value.ToShortDateString()
                                </span>
                            }
                            <div class="relative">
                                <button @onclick="() => ToggleStatusMenu(task.Id)" class="p-1.5 hover:bg-gray-100 rounded-lg transition">
                                    <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                                </button>
                                @if (openStatusMenuId == task.Id)
                                {
                                    <div class="absolute right-0 top-8 z-50 bg-white rounded-xl shadow-lg ring-1 ring-gray-100 py-1.5 min-w-44">
                                        <div class="px-3 py-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wider">Сменить статус</div>
                                        @foreach (var trans in GetAllowedStatusTransitions(task.Status))
                                        {
                                            <button @onclick="() => MoveStatus(task.Id, trans.Value)" class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 flex items-center gap-2.5 transition">
                                                <span class="w-2 h-2 rounded-full @trans.DotClass"></span>
                                                @trans.Label
                                            </button>
                                        }
                                        <div class="border-t border-gray-100 my-1"></div>
                                        <button @onclick="() => OpenEditForm(task)" class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 flex items-center gap-2.5 transition text-gray-600">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            Редактировать
                                        </button>
                                        <button @onclick="() => DeleteTask(task.Id)" class="w-full text-left px-3 py-2 text-sm hover:bg-red-50 flex items-center gap-2.5 transition text-red-600">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            Удалить
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-16 bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)]">
            <svg class="w-12 h-12 mx-auto text-gray-200 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <p class="text-gray-400 text-sm">@(string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(statusFilter) && string.IsNullOrEmpty(priorityFilter) && string.IsNullOrEmpty(clientFilter) ? "Задач пока нет" : "Ничего не найдено")</p>
            @if (string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(statusFilter) && string.IsNullOrEmpty(priorityFilter) && string.IsNullOrEmpty(clientFilter))
            {
                <button @onclick="OpenCreateForm" class="mt-4 text-blue-600 hover:text-blue-700 text-sm font-medium transition">Создать первую задачу</button>
            }
        </div>
    }
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;

    private List<TaskDto> tasks = new();
    private List<ClientRef> availableClients = new();
    private string searchQuery = "";
    private string statusFilter = "";
    private string priorityFilter = "";
    private string clientFilter = "";
    private Guid? openStatusMenuId;

    private IEnumerable<TaskDto> filteredTasks
    {
        get
        {
            var result = tasks.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchQuery))
                result = result.Where(t => t.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (t.Description?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            if (!string.IsNullOrWhiteSpace(statusFilter))
                result = result.Where(t => GetStatusInt(t.Status) == int.Parse(statusFilter));
            if (!string.IsNullOrWhiteSpace(priorityFilter))
                result = result.Where(t => t.Priority == priorityFilter || GetPriorityInt(t.Priority) == int.Parse(priorityFilter));
            if (!string.IsNullOrWhiteSpace(clientFilter))
                result = result.Where(t => t.RelatedEntityType == "Client" && t.RelatedEntityId.HasValue && t.RelatedEntityId.Value.ToString() == clientFilter);
            return result;
        }
    }

    private bool isLoading = true;
    private bool showForm;
    private bool isSubmitting;
    private string? formError;
    private Guid? editingId;

    private TaskForm form = new();

    private readonly record struct StatusColumn(int Value, string Label, string ActiveClass, string InactiveClass);
    private readonly List<StatusColumn> statusColumns = new()
    {
        new(1, "Новая", "bg-blue-100 text-blue-700 ring-1 ring-blue-200", "bg-blue-50 text-blue-400 hover:bg-blue-100"),
        new(2, "В работе", "bg-amber-100 text-amber-700 ring-1 ring-amber-200", "bg-amber-50 text-amber-400 hover:bg-amber-100"),
        new(3, "На проверке", "bg-purple-100 text-purple-700 ring-1 ring-purple-200", "bg-purple-50 text-purple-400 hover:bg-purple-100"),
        new(4, "Завершена", "bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200", "bg-emerald-50 text-emerald-400 hover:bg-emerald-100"),
        new(5, "Отменена", "bg-gray-100 text-gray-700 ring-1 ring-gray-200", "bg-gray-50 text-gray-400 hover:bg-gray-100")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
        await LoadTasks();
    }

    private async Task LoadClients()
    {
        var result = await Api.GetAsync<PagedResult<ClientRef>>("/api/clients/clients");
        if (result != null) availableClients = result.Items.ToList();
    }

    private async Task LoadTasks()
    {
        isLoading = true;
        var result = await Api.GetAsync<PagedResult<TaskDto>>("/api/tasks/tasks");
        if (result != null) tasks = result.Items.ToList();
        isLoading = false;
        StateHasChanged();
    }

    private void OpenCreateForm()
    {
        editingId = null;
        form = new TaskForm { Priority = 2, ClientId = "" };
        formError = null;
        showForm = true;
    }

    private void OpenEditForm(TaskDto task)
    {
        editingId = task.Id;
        form = new TaskForm
        {
            Title = task.Title,
            Description = task.Description ?? "",
            ClientId = (task.RelatedEntityType == "Client" && task.RelatedEntityId.HasValue) ? task.RelatedEntityId.Value.ToString() : "",
            DueDate = task.DueDate,
            Priority = GetPriorityInt(task.Priority)
        };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveTask()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            formError = "Название обязательно";
            return;
        }

        isSubmitting = true;
        formError = null;
        try
        {
            var clientId = string.IsNullOrWhiteSpace(form.ClientId) ? (Guid?)null : Guid.Parse(form.ClientId);
            if (editingId == null)
            {
                var payload = new
                {
                    Title = form.Title,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    DueDate = form.DueDate,
                    Priority = form.Priority,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty,
                    RelatedEntityType = clientId.HasValue ? 1 : (int?)null,
                    RelatedEntityId = clientId
                };
                await Api.PostAsync<TaskDto>("/api/tasks/tasks", payload);
            }
            else
            {
                var payload = new
                {
                    Title = form.Title,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    DueDate = form.DueDate,
                    Priority = form.Priority,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PutAsync<TaskDto>($"/api/tasks/tasks/{editingId}", payload);
            }
            showForm = false;
            await LoadTasks();
        }
        catch (Exception)
        {
            formError = "Ошибка при сохранении задачи";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task MoveStatus(Guid taskId, int newStatus)
    {
        openStatusMenuId = null;
        await Api.PutAsync<TaskDto>($"/api/tasks/tasks/{taskId}/status", new { NewStatus = newStatus });
        await LoadTasks();
    }

    private void ToggleStatusMenu(Guid taskId)
    {
        openStatusMenuId = openStatusMenuId == taskId ? null : taskId;
    }

    private void ToggleFunnelFilter(int value)
    {
        statusFilter = statusFilter == value.ToString() ? "" : value.ToString();
    }

    private async Task DeleteTask(Guid id)
    {
        await Api.DeleteAsync($"/api/tasks/tasks/{id}");
        await LoadTasks();
    }

    private int GetStatusInt(string s) => s switch
    {
        "1" or "Новая" => 1, "2" or "ВРаботе" => 2,
        "3" or "НаПроверке" => 3, "4" or "Завершена" => 4,
        "5" or "Отменена" => 5, _ => 1
    };

    private int GetPriorityInt(string p) => p switch
    {
        "1" or "Низкий" => 1, "2" or "Средний" => 2,
        "3" or "Высокий" => 3, "4" or "Критический" => 4, _ => 2
    };

    private List<StatusTransition> GetAllowedStatusTransitions(string currentStatus)
    {
        var status = GetStatusInt(currentStatus);
        return status switch
        {
            1 => [new(2, "В работу", "bg-yellow-400"), new(5, "Отменить", "bg-gray-400")],
            2 => [new(3, "На проверку", "bg-purple-400"), new(1, "Новая", "bg-blue-400"), new(5, "Отменить", "bg-gray-400")],
            3 => [new(4, "Завершена", "bg-green-400"), new(2, "В работу", "bg-yellow-400"), new(5, "Отменить", "bg-gray-400")],
            4 => [new(1, "Переоткрыть", "bg-blue-400")],
            5 => [new(1, "Переоткрыть", "bg-blue-400")],
            _ => []
        };
    }

    private string GetPriorityName(string p) => p switch
    {
        "Низкий" or "1" => "Низкий", "Средний" or "2" => "Средний",
        "Высокий" or "3" => "Высокий", "Критический" or "4" => "Критический", _ => p
    };

    private string GetPriorityColor(string p) => p switch
    {
        "Критический" or "4" => "bg-red-100 text-red-700",
        "Высокий" or "3" => "bg-orange-100 text-orange-700",
        "Средний" or "2" => "bg-yellow-100 text-yellow-700",
        "Низкий" or "1" => "bg-green-100 text-green-700",
        _ => "bg-gray-100 text-gray-600"
    };

    private string GetPriorityDotColor(string p) => p switch
    {
        "Критический" or "4" => "bg-red-500",
        "Высокий" or "3" => "bg-orange-500",
        "Средний" or "2" => "bg-amber-400",
        "Низкий" or "1" => "bg-green-500",
        _ => "bg-gray-400"
    };

    private string GetStatusName(string s) => s switch
    {
        "Новая" or "1" => "Новая", "ВРаботе" or "2" => "В работе",
        "НаПроверке" or "3" => "На проверке", "Завершена" or "4" => "Завершена",
        "Отменена" or "5" => "Отменена", _ => s
    };

    private string GetStatusColor(string s) => s switch
    {
        "Новая" or "1" => "bg-blue-100 text-blue-700",
        "ВРаботе" or "2" => "bg-yellow-100 text-yellow-700",
        "НаПроверке" or "3" => "bg-purple-100 text-purple-700",
        "Завершена" or "4" => "bg-green-100 text-green-700",
        "Отменена" or "5" => "bg-gray-100 text-gray-600",
        _ => "bg-gray-100 text-gray-600"
    };

    private record StatusTransition(int Value, string Label, string DotClass);
    private class TaskForm
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ClientId { get; set; } = "";
        public DateTime? DueDate { get; set; }
        public int Priority { get; set; } = 2;
    }

    private record TaskDto(Guid Id, string Title, string? Description, DateTime? DueDate, string Priority, string Status, Guid AssignedUserId, string? RelatedEntityType, Guid? RelatedEntityId, DateTime CreatedAt);
    private record ClientRef(Guid Id, string CompanyName);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
