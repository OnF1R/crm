@page "/tasks"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Задачи - CRM</PageTitle>

<div>
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Задачи</h1>
            <p class="text-gray-500">Управление задачами</p>
        </div>
        <button @onclick="OpenCreateForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition">
            + Новая задача
        </button>
    </div>

    <div class="mb-4 flex flex-wrap gap-3 items-center">
        <input @bind="searchQuery" @bind:event="oninput" placeholder="Поиск по названию..." class="w-full md:w-96 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" />
        <select @bind="statusFilter" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
            <option value="">Все статусы</option>
            <option value="1">Новая</option>
            <option value="2">В работе</option>
            <option value="3">На проверке</option>
            <option value="4">Завершена</option>
            <option value="5">Отменена</option>
        </select>
        <select @bind="priorityFilter" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
            <option value="">Все приоритеты</option>
            <option value="1">Низкий</option>
            <option value="2">Средний</option>
            <option value="3">Высокий</option>
            <option value="4">Критический</option>
        </select>
    </div>

    <div class="mb-6 grid grid-cols-5 gap-2">
        @foreach (var col in statusColumns)
        {
            var count = tasks.Count(t => GetStatusInt(t.Status) == col.Value);
            <div class="text-center">
                <div class="text-xs font-medium @col.TextClass mb-1">@col.Label</div>
                <div class="text-lg font-bold text-gray-900">@count</div>
            </div>
        }
    </div>

    @if (showForm)
    {
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseForm">
            <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
                <h2 class="text-lg font-bold text-gray-900 mb-4">@(editingId == null ? "Новая задача" : "Редактирование задачи")</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Название *</label>
                        <input @bind="form.Title" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Подготовить КП" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Клиент</label>
                        <select @bind="form.ClientId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="">-- Без клиента --</option>
                            @foreach (var c in availableClients)
                            {
                                <option value="@c.Id">@c.CompanyName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Описание</label>
                        <textarea @bind="form.Description" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Детали задачи"></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Срок</label>
                            <input @bind="form.DueDate" @bind:format="yyyy-MM-dd" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Приоритет</label>
                            <select @bind="form.Priority" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <option value="1">Низкий</option>
                                <option value="2">Средний</option>
                                <option value="3">Высокий</option>
                                <option value="4">Критический</option>
                            </select>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">@formError</div>
                    }
                    <div class="flex justify-end gap-3 pt-2">
                        <button @onclick="CloseForm" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Отмена</button>
                        <button @onclick="SaveTask" disabled="@isSubmitting" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition disabled:opacity-50">
                            @(isSubmitting ? "Сохранение..." : (editingId == null ? "Создать" : "Сохранить"))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (filteredTasks.Any())
    {
        <div class="space-y-3">
            @foreach (var task in filteredTasks)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                    <div class="flex items-center justify-between">
                        <div class="flex-1">
                            <div class="flex items-center gap-3">
                                <NavLink href="@($"tasks/{task.Id}")" class="font-medium text-gray-900 hover:text-blue-600 transition">@task.Title</NavLink>
                                <span class="px-2 py-0.5 text-xs rounded-full @GetPriorityColor(task.Priority)">@GetPriorityName(task.Priority)</span>
                            </div>
                            <div class="flex items-center gap-3 mt-2">
                                <div class="relative inline-block">
                                    <button @onclick="() => ToggleStatusMenu(task.Id)" class="flex items-center gap-1 px-2 py-0.5 text-xs rounded-full @GetStatusColor(task.Status) hover:opacity-80 transition cursor-pointer">
                                        @GetStatusName(task.Status)
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                    </button>
                                    @if (openStatusMenuId == task.Id)
                                    {
                                        <div class="absolute left-0 top-7 z-50 bg-white border border-gray-200 rounded-lg shadow-lg py-1 min-w-36">
                                            @foreach (var trans in GetAllowedStatusTransitions(task.Status))
                                            {
                                                <button @onclick="() => MoveStatus(task.Id, trans.Value)" class="w-full text-left px-3 py-1.5 text-sm hover:bg-gray-50 flex items-center gap-2">
                                                    <span class="w-2 h-2 rounded-full @trans.DotClass"></span>
                                                    @trans.Label
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (task.RelatedEntityType == "Client" && task.RelatedEntityId.HasValue)
                                {
                                    var clientName = availableClients.FirstOrDefault(c => c.Id == task.RelatedEntityId.Value)?.CompanyName;
                                    <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded">@(clientName ?? "Клиент")</span>
                                }
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="text-xs text-gray-400">Срок: @task.DueDate.Value.ToShortDateString()</span>
                                }
                            </div>
                        </div>
                        <div class="flex items-center gap-2 ml-4 flex-shrink-0">
                            <button @onclick="() => OpenEditForm(task)" class="text-blue-600 hover:text-blue-800 text-sm">Изменить</button>
                            <button @onclick="() => DeleteTask(task.Id)" class="text-red-500 hover:text-red-700 text-sm">Удалить</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!isLoading)
    {
        <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-gray-100">
            <p class="text-gray-400 text-lg">@(string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(statusFilter) && string.IsNullOrEmpty(priorityFilter) ? "Задач нет" : "Ничего не найдено")</p>
            @if (string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(statusFilter) && string.IsNullOrEmpty(priorityFilter))
            {
                <button @onclick="OpenCreateForm" class="mt-4 text-blue-600 hover:underline text-sm">Создать первую задачу</button>
            }
        </div>
    }
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;

    private List<TaskDto> tasks = new();
    private List<ClientRef> availableClients = new();
    private string searchQuery = "";
    private string statusFilter = "";
    private string priorityFilter = "";
    private Guid? openStatusMenuId;

    private IEnumerable<TaskDto> filteredTasks
    {
        get
        {
            var result = tasks.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchQuery))
                result = result.Where(t => t.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (t.Description?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            if (!string.IsNullOrWhiteSpace(statusFilter))
                result = result.Where(t => GetStatusInt(t.Status) == int.Parse(statusFilter));
            if (!string.IsNullOrWhiteSpace(priorityFilter))
                result = result.Where(t => t.Priority == priorityFilter || GetPriorityInt(t.Priority) == int.Parse(priorityFilter));
            return result;
        }
    }

    private bool isLoading = true;
    private bool showForm;
    private bool isSubmitting;
    private string? formError;
    private Guid? editingId;

    private TaskForm form = new();

    private readonly record struct StatusColumn(int Value, string Label, string TextClass);
    private readonly List<StatusColumn> statusColumns = new()
    {
        new(1, "Новая", "text-blue-600"),
        new(2, "В работе", "text-yellow-600"),
        new(3, "На проверке", "text-purple-600"),
        new(4, "Завершена", "text-green-600"),
        new(5, "Отменена", "text-gray-600")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
        await LoadTasks();
    }

    private async Task LoadClients()
    {
        var result = await Api.GetAsync<PagedResult<ClientRef>>("/api/clients/clients");
        if (result != null) availableClients = result.Items.ToList();
    }

    private async Task LoadTasks()
    {
        isLoading = true;
        var result = await Api.GetAsync<PagedResult<TaskDto>>("/api/tasks/tasks");
        if (result != null) tasks = result.Items.ToList();
        isLoading = false;
        StateHasChanged();
    }

    private void OpenCreateForm()
    {
        editingId = null;
        form = new TaskForm { Priority = 2, ClientId = "" };
        formError = null;
        showForm = true;
    }

    private void OpenEditForm(TaskDto task)
    {
        editingId = task.Id;
        form = new TaskForm
        {
            Title = task.Title,
            Description = task.Description ?? "",
            ClientId = (task.RelatedEntityType == "Client" && task.RelatedEntityId.HasValue) ? task.RelatedEntityId.Value.ToString() : "",
            DueDate = task.DueDate,
            Priority = GetPriorityInt(task.Priority)
        };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveTask()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            formError = "Название обязательно";
            return;
        }

        isSubmitting = true;
        formError = null;
        try
        {
            var clientId = string.IsNullOrWhiteSpace(form.ClientId) ? (Guid?)null : Guid.Parse(form.ClientId);
            if (editingId == null)
            {
                var payload = new
                {
                    Title = form.Title,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    DueDate = form.DueDate,
                    Priority = form.Priority,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty,
                    RelatedEntityType = clientId.HasValue ? 1 : (int?)null,
                    RelatedEntityId = clientId
                };
                await Api.PostAsync<TaskDto>("/api/tasks/tasks", payload);
            }
            else
            {
                var payload = new
                {
                    Title = form.Title,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    DueDate = form.DueDate,
                    Priority = form.Priority,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PutAsync<TaskDto>($"/api/tasks/tasks/{editingId}", payload);
            }
            showForm = false;
            await LoadTasks();
        }
        catch (Exception)
        {
            formError = "Ошибка при сохранении задачи";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task MoveStatus(Guid taskId, int newStatus)
    {
        openStatusMenuId = null;
        await Api.PutAsync<TaskDto>($"/api/tasks/tasks/{taskId}/status", new { NewStatus = newStatus });
        await LoadTasks();
    }

    private void ToggleStatusMenu(Guid taskId)
    {
        openStatusMenuId = openStatusMenuId == taskId ? null : taskId;
    }

    private async Task DeleteTask(Guid id)
    {
        await Api.DeleteAsync($"/api/tasks/tasks/{id}");
        await LoadTasks();
    }

    private int GetStatusInt(string s) => s switch
    {
        "1" or "Новая" => 1, "2" or "ВРаботе" => 2,
        "3" or "НаПроверке" => 3, "4" or "Завершена" => 4,
        "5" or "Отменена" => 5, _ => 1
    };

    private int GetPriorityInt(string p) => p switch
    {
        "1" or "Низкий" => 1, "2" or "Средний" => 2,
        "3" or "Высокий" => 3, "4" or "Критический" => 4, _ => 2
    };

    private List<StatusTransition> GetAllowedStatusTransitions(string currentStatus)
    {
        var status = GetStatusInt(currentStatus);
        return status switch
        {
            1 => [new(2, "В работу", "bg-yellow-400"), new(5, "Отменить", "bg-gray-400")],
            2 => [new(3, "На проверку", "bg-purple-400"), new(1, "Новая", "bg-blue-400"), new(5, "Отменить", "bg-gray-400")],
            3 => [new(4, "Завершена", "bg-green-400"), new(2, "В работу", "bg-yellow-400"), new(5, "Отменить", "bg-gray-400")],
            4 => [new(1, "Переоткрыть", "bg-blue-400")],
            5 => [new(1, "Переоткрыть", "bg-blue-400")],
            _ => []
        };
    }

    private string GetPriorityName(string p) => p switch
    {
        "Низкий" or "1" => "Низкий", "Средний" or "2" => "Средний",
        "Высокий" or "3" => "Высокий", "Критический" or "4" => "Критический", _ => p
    };

    private string GetPriorityColor(string p) => p switch
    {
        "Критический" or "4" => "bg-red-100 text-red-700",
        "Высокий" or "3" => "bg-orange-100 text-orange-700",
        "Средний" or "2" => "bg-yellow-100 text-yellow-700",
        "Низкий" or "1" => "bg-green-100 text-green-700",
        _ => "bg-gray-100 text-gray-600"
    };

    private string GetStatusName(string s) => s switch
    {
        "Новая" or "1" => "Новая", "ВРаботе" or "2" => "В работе",
        "НаПроверке" or "3" => "На проверке", "Завершена" or "4" => "Завершена",
        "Отменена" or "5" => "Отменена", _ => s
    };

    private string GetStatusColor(string s) => s switch
    {
        "Новая" or "1" => "bg-blue-100 text-blue-700",
        "ВРаботе" or "2" => "bg-yellow-100 text-yellow-700",
        "НаПроверке" or "3" => "bg-purple-100 text-purple-700",
        "Завершена" or "4" => "bg-green-100 text-green-700",
        "Отменена" or "5" => "bg-gray-100 text-gray-600",
        _ => "bg-gray-100 text-gray-600"
    };

    private record StatusTransition(int Value, string Label, string DotClass);
    private class TaskForm
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ClientId { get; set; } = "";
        public DateTime? DueDate { get; set; }
        public int Priority { get; set; } = 2;
    }

    private record TaskDto(Guid Id, string Title, string? Description, DateTime? DueDate, string Priority, string Status, Guid AssignedUserId, string? RelatedEntityType, Guid? RelatedEntityId, DateTime CreatedAt);
    private record ClientRef(Guid Id, string CompanyName);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
