@page "/"
@page "/login"
@using Crm.Web.Auth

<PageTitle>Вход - CRM</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg p-8">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-900">CRM Система</h1>
                <p class="text-gray-500 mt-2">Войдите в свой аккаунт</p>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                    @error
                </div>
            }

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="login">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" @bind="loginModel.Email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="email@example.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Пароль</label>
                        <input type="password" @bind="loginModel.Password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Введите пароль" />
                    </div>
                    <button type="submit" disabled="@isLoading" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition disabled:opacity-50">
                        @if (isLoading)
                        {
                            <span>Вход...</span>
                        }
                        else
                        {
                            <span>Войти</span>
                        }
                    </button>
                </div>
            </EditForm>

            <div class="mt-6 text-center">
                <p class="text-sm text-gray-500">Нет аккаунта?</p>
                <button @onclick="ShowRegister" class="text-blue-600 hover:underline text-sm">Зарегистрироваться</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthState authState { get; set; } = default!;

    private LoginModel loginModel = new();
    private string? error;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (authState.IsAuthenticated)
            Nav.NavigateTo("/dashboard", true);
    }
    private bool showRegister;

    private async Task HandleLogin()
    {
        isLoading = true;
        error = null;
        try
        {
            var success = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
            if (success)
                Nav.NavigateTo("/dashboard", true);
            else
                error = "Неверный email или пароль";
        }
        catch (Exception)
        {
            error = "Ошибка подключения к серверу";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowRegister() => Nav.NavigateTo("/register");

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
