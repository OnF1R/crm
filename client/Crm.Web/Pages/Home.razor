@page "/"
@page "/login"
@using Crm.Web.Auth

<PageTitle>Вход - CRM</PageTitle>

<div class="min-h-screen flex">
    <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-gradient-to-br from-brand-600 to-brand-800 items-center justify-center">
        <div class="absolute top-[-80px] left-[-80px] w-72 h-72 rounded-full bg-white/5"></div>
        <div class="absolute top-[120px] left-[60px] w-40 h-40 rounded-full bg-white/5"></div>
        <div class="absolute bottom-[-60px] right-[-60px] w-96 h-96 rounded-full bg-white/5"></div>
        <div class="absolute bottom-[100px] right-[120px] w-48 h-48 rounded-full bg-white/5"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full border border-white/10"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] h-[340px] rounded-full border border-white/10"></div>
        <div class="relative z-10 px-12 max-w-md">
            <div class="w-14 h-14 rounded-2xl bg-white/15 backdrop-blur-sm flex items-center justify-center mb-8">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <h1 class="text-4xl font-bold text-white mb-4 leading-tight">CRM Система</h1>
            <p class="text-lg text-white/70 leading-relaxed">Управляйте клиентами, сделками и задачами в одном месте</p>
        </div>
    </div>

    <div class="w-full lg:w-1/2 flex items-center justify-center bg-white p-6 sm:p-12">
        <div class="w-full max-w-md">
            <div class="lg:hidden mb-8 text-center">
                <h1 class="text-2xl font-bold text-brand-600">CRM Система</h1>
            </div>

            <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900">Вход в аккаунт</h2>
                <p class="mt-2 text-sm text-gray-500">Введите свои данные для доступа к системе</p>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="mb-6 p-4 bg-danger-50 border border-danger-200 rounded-xl text-danger-500 text-sm">
                    @error
                </div>
            }

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="login">
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                        <input type="email" @bind="loginModel.Email"
                               class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400
                                      focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent focus:bg-white
                                      transition duration-200"
                               placeholder="email@example.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Пароль</label>
                        <input type="password" @bind="loginModel.Password"
                               class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400
                                      focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent focus:bg-white
                                      transition duration-200"
                               placeholder="Введите пароль" />
                    </div>
                    <button type="submit" disabled="@isLoading"
                            class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-xl
                                   transition duration-200 disabled:opacity-50 disabled:cursor-not-allowed
                                   hover:shadow-lg hover:shadow-brand-600/25 flex items-center justify-center gap-2">
                        @if (isLoading)
                        {
                            <svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                            <span>Вход...</span>
                        }
                        else
                        {
                            <span>Войти</span>
                        }
                    </button>
                </div>
            </EditForm>

            <div class="mt-8 text-center">
                <p class="text-sm text-gray-500">Нет аккаунта? <a href="/register" class="font-medium text-brand-600 hover:text-brand-700 transition">Зарегистрироваться</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthState authState { get; set; } = default!;

    private LoginModel loginModel = new();
    private string? error;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (authState.IsAuthenticated)
            Nav.NavigateTo("/dashboard", true);
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        error = null;
        try
        {
            var success = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
            if (success)
                Nav.NavigateTo("/dashboard", true);
            else
                error = "Неверный email или пароль";
        }
        catch (Exception)
        {
            error = "Ошибка подключения к серверу";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
