@page "/clients"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Клиенты - CRM</PageTitle>

<div>
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Клиенты</h1>
            <p class="text-gray-500">Управление клиентской базой</p>
        </div>
        <button @onclick="OpenCreateForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition">
            + Добавить клиента
        </button>
    </div>

    <div class="mb-4">
        <input @bind="searchQuery" @bind:event="oninput" placeholder="Поиск по названию, ИНН, описанию..." class="w-full md:w-96 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" />
    </div>

    @if (showForm)
    {
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseForm">
            <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
                <h2 class="text-lg font-bold text-gray-900 mb-4">@(editingId == null ? "Новый клиент" : "Редактирование клиента")</h2>
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white text-xl font-bold flex-shrink-0">
                            @(string.IsNullOrWhiteSpace(form.CompanyName) ? "?" : form.CompanyName.Substring(0, 1).ToUpper())
                        </div>
                        <div class="flex-1">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Название компании *</label>
                            <input @bind="form.CompanyName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="ООО Ромашка" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Описание</label>
                        <textarea @bind="form.Description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Краткое описание клиента..."></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">URL аватарки</label>
                        <input @bind="form.AvatarUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="https://example.com/logo.png" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ИНН</label>
                            <input @bind="form.Inn" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="1234567890" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Сайт</label>
                            <input @bind="form.Website" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="example.com" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Отрасль</label>
                        <select @bind="form.Industry" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="1">IT</option>
                            <option value="2">Финансы</option>
                            <option value="3">Производство</option>
                            <option value="4">Ритейл</option>
                            <option value="5">Здравоохранение</option>
                            <option value="6">Образование</option>
                            <option value="7">Другое</option>
                        </select>
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">@formError</div>
                    }
                    <div class="flex justify-end gap-3 pt-2">
                        <button @onclick="CloseForm" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Отмена</button>
                        <button @onclick="SaveClient" disabled="@isSubmitting" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition disabled:opacity-50">
                            @(isSubmitting ? "Сохранение..." : (editingId == null ? "Создать" : "Сохранить"))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (filteredClients.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var client in filteredClients)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition">
                    <div class="flex items-start gap-3">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white text-lg font-bold flex-shrink-0">
                            @if (!string.IsNullOrEmpty(client.AvatarUrl))
                            {
                                <img src="@client.AvatarUrl" alt="@client.CompanyName" class="w-12 h-12 rounded-full object-cover" onerror="this.style.display='none';this.parentElement.innerHTML='@client.CompanyName.Substring(0,1).ToUpper()'" />
                            }
                            else
                            {
                                @client.CompanyName.Substring(0, 1).ToUpper()
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-gray-900 truncate">@client.CompanyName</h3>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="px-2 py-0.5 text-xs rounded-full @GetStatusColor(client.Status)">@GetStatusName(client.Status)</span>
                                <span class="text-xs text-gray-400">@GetIndustryName(client.Industry)</span>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(client.Description))
                    {
                        <p class="text-sm text-gray-600 mt-3 line-clamp-2">@client.Description</p>
                    }
                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-gray-50">
                        <div class="text-xs text-gray-400">
                            @(client.Inn ?? "—") &middot; @client.CreatedAt.ToShortDateString()
                        </div>
                        <div class="flex gap-2">
                            <button @onclick="() => OpenEditForm(client)" class="text-blue-600 hover:text-blue-800 text-sm">Изменить</button>
                            <button @onclick="() => DeleteClient(client.Id)" class="text-red-500 hover:text-red-700 text-sm">Удалить</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!isLoading)
    {
        <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-gray-100">
            <p class="text-gray-400 text-lg">@(string.IsNullOrEmpty(searchQuery) ? "Клиенты не найдены" : "Ничего не найдено")</p>
            @if (string.IsNullOrEmpty(searchQuery))
            {
                <button @onclick="OpenCreateForm" class="mt-4 text-blue-600 hover:underline text-sm">Добавить первого клиента</button>
            }
        </div>
    }
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;

    private List<ClientDto> clients = new();
    private string searchQuery = "";
    private IEnumerable<ClientDto> filteredClients => string.IsNullOrWhiteSpace(searchQuery)
        ? clients
        : clients.Where(c =>
            c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (c.Description?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.Inn?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private bool isLoading = true;
    private bool showForm;
    private bool isSubmitting;
    private string? formError;
    private Guid? editingId;

    private ClientForm form = new();

    protected override async Task OnInitializedAsync() => await LoadClients();

    private async Task LoadClients()
    {
        isLoading = true;
        var result = await Api.GetAsync<PagedResult<ClientDto>>("/api/clients/clients");
        if (result != null) clients = result.Items.ToList();
        isLoading = false;
        StateHasChanged();
    }

    private void OpenCreateForm()
    {
        editingId = null;
        form = new ClientForm { Industry = 1 };
        formError = null;
        showForm = true;
    }

    private void OpenEditForm(ClientDto client)
    {
        editingId = client.Id;
        form = new ClientForm
        {
            CompanyName = client.CompanyName,
            Description = client.Description ?? "",
            AvatarUrl = client.AvatarUrl ?? "",
            Inn = client.Inn ?? "",
            Website = client.Website ?? "",
            Industry = ParseIndustryInt(client.Industry)
        };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(form.CompanyName))
        {
            formError = "Название компании обязательно";
            return;
        }

        isSubmitting = true;
        formError = null;
        try
        {
            if (editingId == null)
            {
                var payload = new
                {
                    CompanyName = form.CompanyName,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    AvatarUrl = string.IsNullOrWhiteSpace(form.AvatarUrl) ? (string?)null : form.AvatarUrl,
                    Inn = string.IsNullOrWhiteSpace(form.Inn) ? (string?)null : form.Inn,
                    Website = string.IsNullOrWhiteSpace(form.Website) ? (string?)null : form.Website,
                    Industry = form.Industry,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PostAsync<ClientDto>("/api/clients/clients", payload);
            }
            else
            {
                var payload = new
                {
                    CompanyName = form.CompanyName,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    AvatarUrl = string.IsNullOrWhiteSpace(form.AvatarUrl) ? (string?)null : form.AvatarUrl,
                    Inn = string.IsNullOrWhiteSpace(form.Inn) ? (string?)null : form.Inn,
                    Website = string.IsNullOrWhiteSpace(form.Website) ? (string?)null : form.Website,
                    Industry = form.Industry,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PutAsync<ClientDto>($"/api/clients/clients/{editingId}", payload);
            }
            showForm = false;
            await LoadClients();
        }
        catch (Exception)
        {
            formError = "Ошибка при сохранении клиента";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteClient(Guid id)
    {
        await Api.DeleteAsync($"/api/clients/clients/{id}");
        await LoadClients();
    }

    private int ParseIndustryInt(string industry) => industry switch
    {
        "1" or "IT" => 1, "2" or "Финансы" => 2, "3" or "Производство" => 3,
        "4" or "Ритейл" => 4, "5" or "Здравоохранение" => 5,
        "6" or "Образование" => 6, _ => 7
    };

    private string GetIndustryName(string industry) => industry switch
    {
        "IT" or "1" => "IT", "Финансы" or "2" => "Финансы",
        "Производство" or "3" => "Производство", "Ритейл" or "4" => "Ритейл",
        "Здравоохранение" or "5" => "Здравоохранение",
        "Образование" or "6" => "Образование", _ => "Другое"
    };

    private string GetStatusName(string status) => status switch
    {
        "Новый" or "1" => "Новый", "ВРаботе" or "2" => "В работе",
        "Потенциальный" or "3" => "Потенциальный", "Закрытый" or "4" => "Закрытый", _ => status
    };

    private string GetStatusColor(string status) => status switch
    {
        "Новый" or "1" => "bg-blue-100 text-blue-700",
        "ВРаботе" or "2" => "bg-yellow-100 text-yellow-700",
        "Потенциальный" or "3" => "bg-green-100 text-green-700",
        "Закрытый" or "4" => "bg-gray-100 text-gray-700",
        _ => "bg-gray-100 text-gray-600"
    };

    private class ClientForm
    {
        public string CompanyName { get; set; } = "";
        public string Description { get; set; } = "";
        public string AvatarUrl { get; set; } = "";
        public string Inn { get; set; } = "";
        public string Website { get; set; } = "";
        public int Industry { get; set; } = 1;
    }

    private record ClientDto(Guid Id, string CompanyName, string? Description, string? AvatarUrl, string? Inn, string? Website, string Industry, string Status, Guid AssignedUserId, DateTime CreatedAt, List<ContactDto> Contacts);
    private record ContactDto(Guid Id, Guid ClientId, string FirstName, string LastName, string FullName, string Email, string? Phone, string? Position, bool IsPrimary);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
