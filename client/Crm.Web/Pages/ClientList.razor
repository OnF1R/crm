@page "/clients"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Клиенты - CRM</PageTitle>

<div class="min-h-screen bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Клиенты</h1>
                <p class="text-slate-500 mt-1">Управление клиентской базой</p>
            </div>
            <div class="flex items-center gap-3">
                <button @onclick="OpenTagsForm" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50 text-slate-700 hover:text-indigo-700 rounded-xl font-medium transition-all duration-200">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                    Теги
                </button>
                <button @onclick="OpenCreateForm" class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-all duration-200 shadow-[0_2px_12px_-2px_rgba(79,70,229,0.4)] hover:shadow-[0_4px_18px_-2px_rgba(79,70,229,0.5)]">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    Добавить клиента
                </button>
            </div>
        </div>

        <div class="relative mb-6">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <input @bind="searchQuery" @bind:event="oninput" placeholder="Поиск по названию, ИНН, описанию..." class="w-full sm:max-w-md pl-11 pr-4 py-3 bg-white rounded-xl border-0 shadow-[0_2px_15px_-3px_rgba(203,213,225,0.3)] focus:shadow-[0_2px_20px_-3px_rgba(99,102,241,0.3)] focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm text-slate-700 placeholder:text-slate-400 transition-all duration-200" />
        </div>

        @if (isLoading)
        {
            <div class="flex items-center justify-center py-20">
                <div class="flex flex-col items-center gap-3">
                    <svg class="animate-spin h-8 w-8 text-indigo-500" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                    <span class="text-slate-400 text-sm">Загрузка...</span>
                </div>
            </div>
        }
        else if (filteredClients.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                @foreach (var client in filteredClients)
                {
                    <div class="bg-white rounded-2xl shadow-[0_2px_15px_-3px_rgba(203,213,225,0.3)] hover:shadow-[0_4px_20px_-4px_rgba(203,213,225,0.45)] p-5 transition-all duration-200 cursor-pointer group">
                        <div class="flex items-start gap-3.5">
                            @if (!string.IsNullOrEmpty(client.AvatarUrl))
                            {
                                <img src="@client.AvatarUrl" alt="@client.CompanyName" class="w-12 h-12 rounded-full object-cover flex-shrink-0 ring-2 ring-indigo-100" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center text-white text-lg font-bold flex-shrink-0 shadow-[0_2px_8px_-2px_rgba(79,70,229,0.4)]" style="display:none">
                                    @client.CompanyName.Substring(0, 1).ToUpper()
                                </div>
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center text-white text-lg font-bold flex-shrink-0 shadow-[0_2px_8px_-2px_rgba(79,70,229,0.4)]">
                                    @client.CompanyName.Substring(0, 1).ToUpper()
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <h3 class="font-semibold text-slate-900 truncate group-hover:text-indigo-600 transition-colors">@client.CompanyName</h3>
                                <div class="flex items-center flex-wrap gap-1.5 mt-1.5">
                                    <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium rounded-full @GetStatusColor(client.Status)">@GetStatusName(client.Status)</span>
                                    <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium rounded-full bg-slate-100 text-slate-600">@GetIndustryName(client.Industry)</span>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(client.Description))
                        {
                            <p class="text-sm text-slate-600 mt-3.5 line-clamp-2 leading-relaxed">@client.Description</p>
                        }
                        <div class="flex items-center justify-between mt-4 pt-3.5 border-t border-slate-100">
                            <div class="flex items-center gap-1.5 text-xs text-slate-400">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                @(client.Inn ?? "—")
                            </div>
                            <div class="text-xs text-slate-400">@client.CreatedAt.ToShortDateString()</div>
                        </div>
                        @if (client.Tags != null && client.Tags.Any())
                        {
                            <div class="flex flex-wrap gap-1.5 mt-3">
                                @foreach (var tag in client.Tags)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full" style="background-color: @(tag.Color + "22"); color: @(tag.Color ?? "#6366f1");">
                                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: @(tag.Color ?? "#6366f1");"></span>
                                        @tag.Name
                                    </span>
                                }
                            </div>
                        }
                        <div class="flex items-center justify-end gap-1 mt-2">
                            <button @onclick="() => OpenTagAssignModal(client)" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all duration-150">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                                Теги
                            </button>
                            <button @onclick="() => OpenEditForm(client)" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all duration-150">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                Изменить
                            </button>
                            <button @onclick="() => DeleteClient(client.Id)" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all duration-150">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                Удалить
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-20">
                <svg class="w-24 h-24 text-slate-200 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <p class="text-slate-400 text-lg font-medium">@(string.IsNullOrEmpty(searchQuery) ? "Клиенты не найдены" : "Ничего не найдено")</p>
                <p class="text-slate-300 text-sm mt-1">@(string.IsNullOrEmpty(searchQuery) ? "Начните добавлять клиентов в систему" : "Попробуйте изменить параметры поиска")</p>
                @if (string.IsNullOrEmpty(searchQuery))
                {
                    <button @onclick="OpenCreateForm" class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-all duration-200 shadow-[0_2px_12px_-2px_rgba(79,70,229,0.4)]">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                        Добавить первого клиента
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (showTagsForm)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4" @onclick="CloseTagsForm">
        <div class="bg-white rounded-2xl shadow-[0_10px_40px_-10px_rgba(203,213,225,0.5)] w-full max-w-2xl max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
            <div class="p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-slate-900">Управление тегами</h2>
                    <button @onclick="CloseTagsForm" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all duration-150">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>

                <div class="mb-6">
                    <div class="flex items-center gap-3">
                        <input @bind="newTagName" @onkeypress="HandleTagKeyPress" placeholder="Название нового тега" class="flex-1 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition-all duration-200" />
                        <input @bind="newTagColor" type="color" class="w-12 h-11 rounded-xl cursor-pointer border-0" />
                        <button @onclick="CreateTag" class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-all duration-200">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                            Добавить
                        </button>
                    </div>
                </div>

                @if (isLoadingTags)
                {
                    <div class="flex items-center justify-center py-12">
                        <svg class="animate-spin h-6 w-6 text-indigo-500" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                    </div>
                }
                else if (tags.Any())
                {
                    <div class="space-y-2">
                        @foreach (var tag in tags)
                        {
                            <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl group">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(tag.Color))
                                    {
                                        <div class="w-4 h-4 rounded-full" style="background-color: @tag.Color"></div>
                                    }
                                    <span class="font-medium text-slate-900">@tag.Name</span>
                                    @if (!string.IsNullOrEmpty(tag.Description))
                                    {
                                        <span class="text-sm text-slate-400">@tag.Description</span>
                                    }
                                </div>
                                <div class="flex items-center gap-2">
                                    <button @onclick="() => EditTag(tag)" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all duration-150 opacity-0 group-hover:opacity-100">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </button>
                                    <button @onclick="() => DeleteTag(tag.Id)" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all duration-150 opacity-0 group-hover:opacity-100">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-12 text-slate-400">
                        <p>Теги не созданы</p>
                        <p class="text-sm mt-1">Добавьте первый тег для организации клиентов</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (showTagAssignModal && tagAssignClient != null)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4" @onclick="CloseTagAssignModal">
        <div class="bg-white rounded-2xl shadow-[0_10px_40px_-10px_rgba(203,213,225,0.5)] w-full max-w-md max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
            <div class="p-6">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">Теги клиента</h2>
                        <p class="text-sm text-slate-400 mt-0.5">@tagAssignClient.CompanyName</p>
                    </div>
                    <button @onclick="CloseTagAssignModal" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all duration-150">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                @if (isLoadingTags)
                {
                    <div class="flex justify-center py-8">
                        <svg class="animate-spin h-6 w-6 text-indigo-500" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                    </div>
                }
                else if (tags.Any())
                {
                    <div class="space-y-2">
                        @foreach (var tag in tags)
                        {
                            var hasTag = ClientHasTag(tagAssignClient, tag.Id);
                            <button @onclick="() => ToggleClientTag(tag)" class="w-full flex items-center gap-3 p-3 rounded-xl transition-all duration-150 @(hasTag ? "bg-indigo-50 ring-1 ring-indigo-200" : "bg-slate-50 hover:bg-slate-100")">
                                @if (!string.IsNullOrEmpty(tag.Color))
                                {
                                    <div class="w-4 h-4 rounded-full flex-shrink-0" style="background-color: @tag.Color"></div>
                                }
                                <span class="flex-1 text-left font-medium text-slate-900 text-sm">@tag.Name</span>
                                @if (hasTag)
                                {
                                    <svg class="w-4 h-4 text-indigo-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                }
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-8 text-slate-400 text-sm">
                        <p>Нет доступных тегов</p>
                        <p class="mt-1">Сначала создайте теги через кнопку «Теги» на панели инструментов</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (showForm)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4" @onclick="CloseForm">
        <div class="bg-white rounded-2xl shadow-[0_10px_40px_-10px_rgba(203,213,225,0.5)] w-full max-w-lg max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
            <div class="p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-slate-900">@(editingId == null ? "Новый клиент" : "Редактирование клиента")</h2>
                    <button @onclick="CloseForm" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-all duration-150">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>

                <div class="flex flex-col items-center mb-6">
                    @if (!string.IsNullOrWhiteSpace(form.AvatarUrl))
                    {
                        <img src="@form.AvatarUrl" alt="Avatar" class="w-20 h-20 rounded-full object-cover ring-4 ring-indigo-100 shadow-[0_2px_12px_-2px_rgba(79,70,229,0.3)]" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold shadow-[0_2px_12px_-2px_rgba(79,70,229,0.4)]" style="display:none">
                            @(string.IsNullOrWhiteSpace(form.CompanyName) ? "?" : form.CompanyName.Substring(0, 1).ToUpper())
                        </div>
                    }
                    else
                    {
                        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-indigo-400 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold shadow-[0_2px_12px_-2px_rgba(79,70,229,0.4)]">
                            @(string.IsNullOrWhiteSpace(form.CompanyName) ? "?" : form.CompanyName.Substring(0, 1).ToUpper())
                        </div>
                    }
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Название компании *</label>
                        <input @bind="form.CompanyName" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition-all duration-200" placeholder="ООО Ромашка" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Описание</label>
                        <textarea @bind="form.Description" rows="3" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition-all duration-200 resize-none" placeholder="Краткое описание клиента..."></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">URL аватарки</label>
                        <input @bind="form.AvatarUrl" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition-all duration-200" placeholder="https://example.com/logo.png" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1.5">ИНН</label>
                            <input @bind="form.Inn" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition-all duration-200" placeholder="1234567890" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1.5">Сайт</label>
                            <input @bind="form.Website" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition-all duration-200" placeholder="example.com" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Отрасль</label>
                        <select @bind="form.Industry" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent focus:bg-white transition-all duration-200 appearance-none">
                            <option value="1">IT</option>
                            <option value="2">Финансы</option>
                            <option value="3">Производство</option>
                            <option value="4">Ритейл</option>
                            <option value="5">Здравоохранение</option>
                            <option value="6">Образование</option>
                            <option value="7">Другое</option>
                        </select>
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="flex items-center gap-2 p-3 bg-red-50 border border-red-100 rounded-xl text-red-600 text-sm">
                            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            @formError
                        </div>
                    }
                </div>

                <div class="flex items-center justify-end gap-3 mt-6 pt-5 border-t border-slate-100">
                    <button @onclick="CloseForm" class="px-5 py-2.5 border border-slate-200 rounded-xl text-slate-700 font-medium hover:bg-slate-50 transition-all duration-150">Отмена</button>
                    <button @onclick="SaveClient" disabled="@isSubmitting" class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed shadow-[0_2px_12px_-2px_rgba(79,70,229,0.4)]">
                        @if (isSubmitting)
                        {
                            <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                            <span>Сохранение...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span>@(editingId == null ? "Создать" : "Сохранить")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private List<ClientDto> clients = new();
    private string searchQuery = "";
    private IEnumerable<ClientDto> filteredClients => string.IsNullOrWhiteSpace(searchQuery)
        ? clients
        : clients.Where(c =>
            c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (c.Description?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.Inn?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    private bool isLoading = true;
    private bool showForm;
    private bool isSubmitting;
    private string? formError;
    private Guid? editingId;

    // Tags
    private bool showTagsForm;
    private bool isLoadingTags;
    private List<TagDto> tags = new();
    private string newTagName = "";
    private string newTagColor = "#6366f1";

    // Tag assign modal
    private ClientDto? tagAssignClient;
    private bool showTagAssignModal;

    private ClientForm form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
        await LoadTags();
    }

    private async Task LoadClients()
    {
        isLoading = true;
        var result = await Api.GetAsync<PagedResult<ClientDto>>("/api/clients/clients");
        if (result != null) clients = result.Items.ToList();
        isLoading = false;
        StateHasChanged();
    }

    private void OpenCreateForm()
    {
        editingId = null;
        form = new ClientForm { Industry = 1 };
        formError = null;
        showForm = true;
    }

    private void OpenEditForm(ClientDto client)
    {
        editingId = client.Id;
        form = new ClientForm
        {
            CompanyName = client.CompanyName,
            Description = client.Description ?? "",
            AvatarUrl = client.AvatarUrl ?? "",
            Inn = client.Inn ?? "",
            Website = client.Website ?? "",
            Industry = ParseIndustryInt(client.Industry)
        };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(form.CompanyName))
        {
            formError = "Название компании обязательно";
            return;
        }

        isSubmitting = true;
        formError = null;
        try
        {
            if (editingId == null)
            {
                var payload = new
                {
                    CompanyName = form.CompanyName,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    AvatarUrl = string.IsNullOrWhiteSpace(form.AvatarUrl) ? (string?)null : form.AvatarUrl,
                    Inn = string.IsNullOrWhiteSpace(form.Inn) ? (string?)null : form.Inn,
                    Website = string.IsNullOrWhiteSpace(form.Website) ? (string?)null : form.Website,
                    Industry = form.Industry,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PostAsync<ClientDto>("/api/clients/clients", payload);
            }
            else
            {
                var payload = new
                {
                    CompanyName = form.CompanyName,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    AvatarUrl = string.IsNullOrWhiteSpace(form.AvatarUrl) ? (string?)null : form.AvatarUrl,
                    Inn = string.IsNullOrWhiteSpace(form.Inn) ? (string?)null : form.Inn,
                    Website = string.IsNullOrWhiteSpace(form.Website) ? (string?)null : form.Website,
                    Industry = form.Industry,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PutAsync<ClientDto>($"/api/clients/clients/{editingId}", payload);
            }
            showForm = false;
            await LoadClients();
        }
        catch (Exception)
        {
            formError = "Ошибка при сохранении клиента";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteClient(Guid id)
    {
        await Api.DeleteAsync($"/api/clients/clients/{id}");
        await LoadClients();
    }

    // Tag methods
    private async Task LoadTags()
    {
        isLoadingTags = true;
        var result = await Api.GetAllTagsAsync();
        if (result != null) tags = result.ToList();
        isLoadingTags = false;
        StateHasChanged();
    }

    private void OpenTagsForm()
    {
        showTagsForm = true;
        if (!tags.Any())
        {
            LoadTags();
        }
    }

    private void CloseTagsForm() => showTagsForm = false;

    private async Task CreateTag()
    {
        if (string.IsNullOrWhiteSpace(newTagName)) return;

        var result = await Api.CreateTagAsync(new CreateTagDto(newTagName, null, newTagColor));
        if (result != null)
        {
            newTagName = "";
            await LoadTags();
        }
    }

    private void HandleTagKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CreateTag();
        }
    }

    private async Task EditTag(TagDto tag)
    {
        var newName = await JSRuntime.InvokeAsync<string?>("prompt", "Введите новое название тега:", tag.Name);
        if (!string.IsNullOrWhiteSpace(newName) && newName != tag.Name)
        {
            await Api.UpdateTagAsync(tag.Id, new UpdateTagDto(newName, tag.Description, tag.Color));
            await LoadTags();
        }
    }

    private async Task DeleteTag(Guid id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Удалить этот тег?"))
        {
            await Api.DeleteTagAsync(id);
            await LoadTags();
        }
    }

    private void OpenTagAssignModal(ClientDto client)
    {
        tagAssignClient = client;
        showTagAssignModal = true;
        if (!tags.Any()) LoadTags();
    }

    private void CloseTagAssignModal() => showTagAssignModal = false;

    private bool ClientHasTag(ClientDto client, Guid tagId) =>
        client.Tags?.Any(t => t.Id == tagId) ?? false;

    private async Task ToggleClientTag(TagDto tag)
    {
        if (tagAssignClient == null) return;
        if (ClientHasTag(tagAssignClient, tag.Id))
            await Api.RemoveTagFromClientAsync(tagAssignClient.Id, tag.Id);
        else
            await Api.AddTagToClientAsync(tagAssignClient.Id, tag.Id);
        await LoadClients();
        // Refresh tagAssignClient from updated list
        tagAssignClient = clients.FirstOrDefault(c => c.Id == tagAssignClient.Id) ?? tagAssignClient;
        StateHasChanged();
    }

    private int ParseIndustryInt(string industry) => industry switch
    {
        "1" or "IT" => 1, "2" or "Финансы" => 2, "3" or "Производство" => 3,
        "4" or "Ритейл" => 4, "5" or "Здравоохранение" => 5,
        "6" or "Образование" => 6, _ => 7
    };

    private string GetIndustryName(string industry) => industry switch
    {
        "IT" or "1" => "IT", "Финансы" or "2" => "Финансы",
        "Производство" or "3" => "Производство", "Ритейл" or "4" => "Ритейл",
        "Здравоохранение" or "5" => "Здравоохранение",
        "Образование" or "6" => "Образование", _ => "Другое"
    };

    private string GetStatusName(string status) => status switch
    {
        "Новый" or "1" => "Новый", "ВРаботе" or "2" => "В работе",
        "Потенциальный" or "3" => "Потенциальный", "Закрытый" or "4" => "Закрытый", _ => status
    };

    private string GetStatusColor(string status) => status switch
    {
        "Новый" or "1" => "bg-indigo-50 text-indigo-700",
        "ВРаботе" or "2" => "bg-amber-50 text-amber-700",
        "Потенциальный" or "3" => "bg-emerald-50 text-emerald-700",
        "Закрытый" or "4" => "bg-slate-100 text-slate-600",
        _ => "bg-slate-100 text-slate-600"
    };

    private class ClientForm
    {
        public string CompanyName { get; set; } = "";
        public string Description { get; set; } = "";
        public string AvatarUrl { get; set; } = "";
        public string Inn { get; set; } = "";
        public string Website { get; set; } = "";
        public int Industry { get; set; } = 1;
    }

    private record ClientDto(Guid Id, string CompanyName, string? Description, string? AvatarUrl, string? Inn, string? Website, string Industry, string Status, Guid AssignedUserId, DateTime CreatedAt, List<ContactDto> Contacts, List<TagDto>? Tags = null);
    private record ContactDto(Guid Id, Guid ClientId, string FirstName, string LastName, string FullName, string Email, string? Phone, string? Position, bool IsPrimary);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
