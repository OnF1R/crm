@page "/tasks/{taskId:guid}"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Задача - CRM</PageTitle>

@if (task == null)
{
    <div class="text-center py-20">
        @if (isLoading)
        {
            <div class="inline-flex items-center gap-2 text-gray-400">
                <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                Загрузка...
            </div>
        }
        else
        {
            <svg class="w-12 h-12 mx-auto text-gray-200 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-gray-400 text-lg mb-3">Задача не найдена</p>
            <NavLink href="tasks" class="inline-flex items-center gap-1.5 text-blue-600 hover:text-blue-700 text-sm font-medium transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                К списку задач
            </NavLink>
        }
    </div>
}
else
{
    <div class="mb-5">
        <NavLink href="tasks" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-600 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            К списку задач
        </NavLink>
    </div>

    <div class="flex gap-6 items-start">
        <div class="flex-1 min-w-0 space-y-6">
            <div class="bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] p-6">
                <div class="mb-6">
                    @if (isEditingTitle)
                    {
                        <input @bind="editTitle" @bind:event="oninput" @onkeydown="OnTitleKeyDown" class="text-xl font-bold text-gray-900 w-full px-3 py-2 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500" />
                    }
                    else
                    {
                        <h1 class="text-xl font-bold text-gray-900 cursor-pointer hover:bg-gray-50 px-3 py-2 rounded-xl -mx-3 transition" @onclick="StartEditTitle">@task.Title</h1>
                    }
                </div>

                <div>
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Описание</h3>
                    @if (isEditingDesc)
                    {
                        <textarea @bind="editDesc" rows="4" class="w-full px-4 py-2.5 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm resize-none" placeholder="Добавьте описание..."></textarea>
                        <div class="flex gap-2 mt-2">
                            <button @onclick="SaveDesc" class="px-4 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition">Сохранить</button>
                            <button @onclick="CancelEditDesc" class="px-4 py-1.5 bg-gray-100 text-gray-600 text-sm rounded-lg hover:bg-gray-200 transition">Отмена</button>
                        </div>
                    }
                    else
                    {
                        @if (string.IsNullOrWhiteSpace(task.Description))
                        {
                            <div class="text-gray-400 text-sm cursor-pointer hover:bg-gray-50 px-4 py-4 rounded-xl border border-dashed border-gray-200 transition" @onclick="StartEditDesc">Нажмите, чтобы добавить описание</div>
                        }
                        else
                        {
                            <div class="text-gray-700 text-sm whitespace-pre-wrap cursor-pointer hover:bg-gray-50 px-4 py-3 rounded-xl transition" @onclick="StartEditDesc">@task.Description</div>
                        }
                    }
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] p-6">
                <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Вложения</h3>

                <div class="border-2 border-dashed border-gray-200 rounded-xl p-8 text-center transition @(isDragging ? "border-blue-400 bg-blue-50/50" : "hover:border-gray-300")"
                     @ondragenter="OnDragEnter" @ondragleave="OnDragLeave" @ondrop="OnDrop" @ondragover:preventDefault>
                    <svg class="w-10 h-10 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>
                    <p class="text-sm text-gray-400">Перетащите файлы сюда или <span class="text-blue-600 cursor-pointer hover:text-blue-700 font-medium" @onclick="TriggerFileUpload">выберите файлы</span></p>
                </div>
                <InputFile OnChange="OnFileSelected" class="hidden" />

                @if (attachments.Any())
                {
                    <div class="mt-4 space-y-2">
                        @foreach (var att in attachments)
                        {
                            <div class="flex items-center justify-between px-4 py-3 bg-gray-50 rounded-xl hover:bg-gray-100 transition">
                                <div class="flex items-center gap-3 min-w-0">
                                    <svg class="w-5 h-5 @GetFileIconColor(att.ContentType) flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    <span class="text-sm font-medium text-gray-700 truncate">@att.FileName</span>
                                    <span class="text-xs text-gray-400 flex-shrink-0">(@FormatFileSize(att.Size))</span>
                                </div>
                                <div class="flex gap-3 flex-shrink-0">
                                    <button @onclick="() => DownloadAttachment(att)" class="text-blue-600 hover:text-blue-700 text-xs font-medium transition">Скачать</button>
                                    <button @onclick="() => DeleteAttachment(att.Id)" class="text-red-500 hover:text-red-600 text-xs font-medium transition">Удалить</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] p-6">
                <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4">Комментарии</h3>

                @if (comments.Any())
                {
                    <div class="space-y-4 mb-6">
                        @foreach (var comment in comments.OrderBy(c => c.CreatedAt))
                        {
                            <div class="flex gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                    @(comment.AuthorUserId == (authState.User?.Id ?? Guid.Empty) ? "Я" : comment.AuthorUserId.ToString().Substring(0, 2).ToUpper())
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-sm font-medium text-gray-900">@(comment.AuthorUserId == (authState.User?.Id ?? Guid.Empty) ? authState.User?.FullName ?? "Вы" : "Пользователь")</span>
                                        <span class="text-xs text-gray-400">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                    <p class="text-sm text-gray-600 whitespace-pre-wrap">@comment.Content</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="border-t border-gray-100 pt-4">
                    <textarea @bind="newComment" rows="3" class="w-full px-4 py-2.5 bg-gray-50 rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm resize-none placeholder-gray-400" placeholder="Написать комментарий..."></textarea>
                    <div class="flex justify-end mt-2">
                        <button @onclick="SubmitComment" disabled="@string.IsNullOrWhiteSpace(newComment)" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-xl font-medium transition disabled:opacity-40">
                            Отправить
                        </button>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Подзадачи</h3>
                    <button @onclick="ToggleSubTaskForm" class="text-blue-600 hover:text-blue-700 text-sm font-medium transition">
                        @(showSubTaskForm ? "Отмена" : "+ Добавить")
                    </button>
                </div>

                @if (showSubTaskForm)
                {
                    <div class="mb-4 p-4 bg-gray-50 rounded-xl">
                        <input @bind="newSubTaskTitle" placeholder="Название подзадачи" class="w-full px-4 py-2.5 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm mb-2" />
                        <textarea @bind="newSubTaskDesc" rows="2" placeholder="Описание (опционально)" class="w-full px-4 py-2.5 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm resize-none mb-2"></textarea>
                        <div class="flex gap-2">
                            <select @bind="newSubTaskPriority" class="px-3 py-2 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm">
                                <option value="2">Средний</option>
                                <option value="1">Низкий</option>
                                <option value="3">Высокий</option>
                                <option value="4">Критический</option>
                            </select>
                            <button @onclick="CreateSubTask" disabled="@string.IsNullOrWhiteSpace(newSubTaskTitle)" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-xl font-medium transition disabled:opacity-40">
                                Создать
                            </button>
                        </div>
                    </div>
                }

                @if (subTasks.Any())
                {
                    <div class="space-y-2">
                        @foreach (var (subTask, idx) in subTasks.OrderBy(st => st.Order).Select((st, i) => (st, i)))
                        {
                            @if (editingSubTask?.Id == subTask.Id)
                            {
                                <div class="p-4 bg-blue-50 rounded-xl space-y-2">
                                    <input @bind="editSubTaskTitle" class="w-full px-4 py-2 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm" />
                                    <textarea @bind="editSubTaskDesc" rows="2" class="w-full px-4 py-2 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm resize-none"></textarea>
                                    <div class="flex gap-2">
                                        <select @bind="editSubTaskPriority" class="px-3 py-2 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm">
                                            <option value="2">Средний</option>
                                            <option value="1">Низкий</option>
                                            <option value="3">Высокий</option>
                                            <option value="4">Критический</option>
                                        </select>
                                        <button @onclick="() => SaveEditSubTask(subTask)" disabled="@string.IsNullOrWhiteSpace(editSubTaskTitle)" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-xl font-medium transition disabled:opacity-40">Сохранить</button>
                                        <button @onclick="CancelEditSubTask" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm rounded-xl font-medium transition">Отмена</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-3 px-4 py-3 bg-gray-50 rounded-xl hover:bg-gray-100 transition group">
                                    <div class="flex flex-col gap-0.5 mr-1">
                                        <button @onclick="() => MoveSubTaskUp(subTask)" disabled="@(idx == 0)" class="text-gray-300 hover:text-gray-500 disabled:opacity-0 transition leading-none text-xs">▲</button>
                                        <button @onclick="() => MoveSubTaskDown(subTask)" disabled="@(idx == subTasks.Count - 1)" class="text-gray-300 hover:text-gray-500 disabled:opacity-0 transition leading-none text-xs">▼</button>
                                    </div>
                                    <input type="checkbox" checked="@subTask.IsCompleted" @onchange="(e) => ToggleSubTaskCompletion(subTask, e.Value is true)" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500 flex-shrink-0" />
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-medium text-gray-900 @(subTask.IsCompleted ? "line-through text-gray-400" : "")">@subTask.Title</p>
                                        @if (!string.IsNullOrWhiteSpace(subTask.Description))
                                        {
                                            <p class="text-xs text-gray-500 truncate">@subTask.Description</p>
                                        }
                                    </div>
                                    <span class="px-2 py-1 text-xs rounded-full @GetPriorityColor(subTask.Priority) flex-shrink-0">@GetPriorityName(subTask.Priority)</span>
                                    <button @onclick="() => StartEditSubTask(subTask)" class="text-blue-500 hover:text-blue-600 text-sm font-medium transition opacity-0 group-hover:opacity-100">Изменить</button>
                                    <button @onclick="() => DeleteSubTask(subTask.Id)" class="text-red-500 hover:text-red-600 text-sm font-medium transition opacity-0 group-hover:opacity-100">Удалить</button>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6 text-gray-400 text-sm">
                        Нет подзадач
                    </div>
                }
            </div>

            <div class="bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Зависимости</h3>
                    <button @onclick="ToggleDependencyForm" class="text-blue-600 hover:text-blue-700 text-sm font-medium transition">
                        @(showDependencyForm ? "Отмена" : "+ Добавить")
                    </button>
                </div>

                @if (showDependencyForm)
                {
                    <div class="mb-4 p-4 bg-gray-50 rounded-xl">
                        <select @bind="newDependencyPredecessorId" class="w-full px-4 py-2.5 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm mb-2">
                            <option value="@Guid.Empty">Выберите задачу</option>
                            @if (availableTasks.Any())
                            {
                                @foreach (var t in availableTasks.Where(t => t.Id != taskId))
                                {
                                    <option value="@t.Id">@t.Title</option>
                                }
                            }
                        </select>
                        <select @bind="newDependencyType" class="w-full px-4 py-2.5 bg-white rounded-xl border-0 focus:ring-2 focus:ring-blue-500 text-sm mb-2">
                            <option value="1">Finish to Start (начинается после завершения)</option>
                            <option value="2">Start to Start (начинается после начала)</option>
                            <option value="3">Finish to Finish (завершается после завершения)</option>
                        </select>
                        <button @onclick="CreateDependency" class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-xl font-medium transition">
                            Создать зависимость
                        </button>
                    </div>
                }

                @if (dependencies.Any())
                {
                    <div class="space-y-2">
                        @foreach (var dep in dependencies)
                        {
                            <div class="flex items-center gap-3 px-4 py-3 bg-gray-50 rounded-xl hover:bg-gray-100 transition">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900">@GetDependencyDirectionText(dep)</p>
                                    <p class="text-xs text-gray-500">@GetDependencyTypeName(dep.Type)</p>
                                </div>
                                <button @onclick="() => DeleteDependency(dep.Id)" class="text-red-500 hover:text-red-600 text-sm font-medium transition">Удалить</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6 text-gray-400 text-sm">
                        Нет зависимостей
                    </div>
                }
            </div>
        </div>

        <div class="w-72 flex-shrink-0">
            <div class="bg-white rounded-xl shadow-[0_1px_3px_rgba(0,0,0,0.05),0_4px_12px_rgba(0,0,0,0.04)] p-5 space-y-5">
                <div>
                    <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Статус</label>
                    <div class="relative mt-2">
                        <button @onclick="ToggleStatusDropdown" class="w-full flex items-center justify-between px-3 py-2.5 bg-gray-50 rounded-xl hover:bg-gray-100 transition text-sm">
                            <span class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full @GetStatusDotColor(task.Status)"></span>
                                @GetStatusName(task.Status)
                            </span>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        @if (showStatusDropdown)
                        {
                            <div class="absolute left-0 right-0 top-full mt-1 bg-white rounded-xl shadow-lg ring-1 ring-gray-100 z-50 py-1.5">
                                @foreach (var trans in GetAllowedTransitions(task.Status))
                                {
                                    <button @onclick="() => MoveStatus(trans.Value)" class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 flex items-center gap-2.5 transition">
                                        <span class="w-2.5 h-2.5 rounded-full @trans.DotClass"></span>
                                        @trans.Label
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div>
                    <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Приоритет</label>
                    <div class="mt-2">
                        <span class="inline-block px-3 py-1.5 text-sm rounded-full @GetPriorityColor(task.Priority) font-medium">@GetPriorityName(task.Priority)</span>
                    </div>
                </div>

                <div class="border-t border-gray-100 pt-4">
                    <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Детали</label>
                    <div class="mt-3 space-y-3">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Исполнитель</span>
                            <span class="text-gray-900 font-medium">Вы</span>
                        </div>
                        @if (task.RelatedEntityType == "Client" && task.RelatedEntityId.HasValue)
                        {
                            var clientName = availableClients.FirstOrDefault(c => c.Id == task.RelatedEntityId.Value)?.CompanyName;
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400">Клиент</span>
                                <span class="text-gray-900 font-medium">@(clientName ?? "Клиент")</span>
                            </div>
                        }
                        @if (task.DueDate.HasValue)
                        {
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400">Срок</span>
                                <span class="font-medium @GetDueDateClass(task.DueDate.Value)">@task.DueDate.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>
                        }
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-400">Создана</span>
                            <span class="text-gray-900 font-medium">@task.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>

                <div class="border-t border-gray-100 pt-4">
                    <button @onclick="DeleteCurrentTask" class="w-full px-3 py-2 text-red-600 hover:bg-red-50 rounded-xl text-sm transition text-left font-medium">Удалить задачу</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid taskId { get; set; }
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState authState { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private TaskDto? task;
    private List<CommentDto> comments = new();
    private List<AttachmentDto> attachments = new();
    private List<ClientRef> availableClients = new();
    private List<SubTaskDto> subTasks = new();
    private List<TaskDependencyDto> dependencies = new();
    private List<TaskRef> availableTasks = new();
    private bool isLoading = true;
    private bool showStatusDropdown;
    private bool isDragging;
    private string newComment = "";

    private bool isEditingTitle;
    private string editTitle = "";
    private bool isEditingDesc;
    private string editDesc = "";

    private bool showSubTaskForm;
    private string newSubTaskTitle = "";
    private string newSubTaskDesc = "";
    private int newSubTaskPriority = 2;

    private SubTaskDto? editingSubTask;
    private string editSubTaskTitle = "";
    private string editSubTaskDesc = "";
    private int editSubTaskPriority = 2;

    private bool showDependencyForm;
    private Guid newDependencyPredecessorId = Guid.Empty;
    private int newDependencyType = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
        await LoadTask();
        await LoadComments();
        await LoadAttachments();
        await LoadSubTasks();
        await LoadDependencies();
        await LoadTasks();
    }

    private async Task LoadClients()
    {
        var result = await Api.GetAsync<PagedResult<ClientRef>>("/api/clients/clients");
        if (result != null) availableClients = result.Items.ToList();
    }

    private async Task LoadTask()
    {
        isLoading = true;
        var result = await Api.GetAsync<TaskDto>($"/api/tasks/tasks/{taskId}");
        if (result != null) task = result;
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadComments()
    {
        var result = await Api.GetAsync<IReadOnlyList<CommentDto>>($"/api/tasks/tasks/{taskId}/comments");
        if (result != null) comments = result.ToList();
        StateHasChanged();
    }

    private async Task LoadAttachments()
    {
        var result = await Api.GetAsync<PagedResult<AttachmentDto>>($"/api/documents/documents/by-entity?type=Task&id={taskId}");
        if (result != null) attachments = result.Items.ToList();
        StateHasChanged();
    }

    private async Task LoadSubTasks()
    {
        var result = await Api.GetAsync<IReadOnlyList<SubTaskDto>>($"/api/tasks/tasks/{taskId}/subtasks");
        if (result != null) subTasks = result.ToList();
        StateHasChanged();
    }

    private async Task LoadDependencies()
    {
        var result = await Api.GetAsync<IReadOnlyList<TaskDependencyDto>>($"/api/tasks/tasks/{taskId}/dependencies");
        if (result != null) dependencies = result.ToList();
        StateHasChanged();
    }

    private async Task LoadTasks()
    {
        var result = await Api.GetAsync<PagedResult<TaskRef>>("/api/tasks/tasks?page=1&pageSize=100");
        if (result != null) availableTasks = result.Items.ToList();
        StateHasChanged();
    }

    private void StartEditTitle()
    {
        if (task == null) return;
        editTitle = task.Title;
        isEditingTitle = true;
    }

    private async Task OnTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTitle();
        if (e.Key == "Escape") isEditingTitle = false;
    }

    private async Task SaveTitle()
    {
        if (task == null || string.IsNullOrWhiteSpace(editTitle)) { isEditingTitle = false; return; }
        var payload = new { Title = editTitle, Description = task.Description, DueDate = task.DueDate, Priority = GetPriorityInt(task.Priority), AssignedUserId = task.AssignedUserId };
        var result = await Api.PutAsync<TaskDto>($"/api/tasks/tasks/{taskId}", payload);
        if (result != null) task = result;
        isEditingTitle = false;
    }

    private void StartEditDesc()
    {
        if (task == null) return;
        editDesc = task.Description ?? "";
        isEditingDesc = true;
    }

    private void CancelEditDesc() => isEditingDesc = false;

    private async Task SaveDesc()
    {
        if (task == null) return;
        var payload = new { Title = task.Title, Description = string.IsNullOrWhiteSpace(editDesc) ? (string?)null : editDesc, DueDate = task.DueDate, Priority = GetPriorityInt(task.Priority), AssignedUserId = task.AssignedUserId };
        var result = await Api.PutAsync<TaskDto>($"/api/tasks/tasks/{taskId}", payload);
        if (result != null) task = result;
        isEditingDesc = false;
    }

    private async Task SubmitComment()
    {
        if (string.IsNullOrWhiteSpace(newComment)) return;
        var payload = new { Content = newComment.Trim() };
        var result = await Api.PostAsync<CommentDto>($"/api/tasks/tasks/{taskId}/comments", payload);
        if (result != null) comments.Add(result);
        newComment = "";
        StateHasChanged();
    }

