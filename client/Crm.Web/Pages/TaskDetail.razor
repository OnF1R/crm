    private async Task DeleteSubTask(Guid subTaskId)
    {
        await Api.DeleteAsync($"/api/tasks/subtasks/{subTaskId}");
        subTasks.RemoveAll(st => st.Id == subTaskId);
        StateHasChanged();
    }

    private void StartEditSubTask(SubTaskDto subTask)
    {
        editingSubTask = subTask;
        editSubTaskTitle = subTask.Title;
        editSubTaskDesc = subTask.Description ?? "";
        editSubTaskPriority = GetPriorityInt(subTask.Priority);
    }

    private void CancelEditSubTask()
    {
        editingSubTask = null;
    }

    private async Task SaveEditSubTask(SubTaskDto subTask)
    {
        if (string.IsNullOrWhiteSpace(editSubTaskTitle)) return;
        var payload = new { Title = editSubTaskTitle, Description = string.IsNullOrWhiteSpace(editSubTaskDesc) ? (string?)null : editSubTaskDesc, DueDate = subTask.DueDate, Priority = editSubTaskPriority, AssignedUserId = subTask.AssignedUserId, Order = subTask.Order };
        var result = await Api.PutAsync<SubTaskDto>($"/api/tasks/subtasks/{subTask.Id}", payload);
        if (result != null)
        {
            var idx = subTasks.FindIndex(st => st.Id == subTask.Id);
            if (idx >= 0) subTasks[idx] = result;
        }
        editingSubTask = null;
        StateHasChanged();
    }

    private async Task MoveSubTaskUp(SubTaskDto subTask)
    {
        var ordered = subTasks.OrderBy(st => st.Order).ToList();
        var idx = ordered.FindIndex(st => st.Id == subTask.Id);
        if (idx <= 0) return;
        var prev = ordered[idx - 1];
        var newOrder = prev.Order;
        var prevOrder = subTask.Order;
        await Api.PutAsync<SubTaskDto>($"/api/tasks/subtasks/{subTask.Id}", new { Title = subTask.Title, Description = subTask.Description, DueDate = subTask.DueDate, Priority = GetPriorityInt(subTask.Priority), AssignedUserId = subTask.AssignedUserId, Order = newOrder });
        await Api.PutAsync<SubTaskDto>($"/api/tasks/subtasks/{prev.Id}", new { Title = prev.Title, Description = prev.Description, DueDate = prev.DueDate, Priority = GetPriorityInt(prev.Priority), AssignedUserId = prev.AssignedUserId, Order = prevOrder });
        await LoadSubTasks();
    }

    private async Task MoveSubTaskDown(SubTaskDto subTask)
    {
        var ordered = subTasks.OrderBy(st => st.Order).ToList();
        var idx = ordered.FindIndex(st => st.Id == subTask.Id);
        if (idx < 0 || idx >= ordered.Count - 1) return;
        var next = ordered[idx + 1];
        var newOrder = next.Order;
        var nextOrder = subTask.Order;
        await Api.PutAsync<SubTaskDto>($"/api/tasks/subtasks/{subTask.Id}", new { Title = subTask.Title, Description = subTask.Description, DueDate = subTask.DueDate, Priority = GetPriorityInt(subTask.Priority), AssignedUserId = subTask.AssignedUserId, Order = newOrder });
        await Api.PutAsync<SubTaskDto>($"/api/tasks/subtasks/{next.Id}", new { Title = next.Title, Description = next.Description, DueDate = next.DueDate, Priority = GetPriorityInt(next.Priority), AssignedUserId = next.AssignedUserId, Order = nextOrder });
        await LoadSubTasks();
    }

    private async Task ToggleSubTaskCompletion(SubTaskDto subTask, bool isCompleted)
    {
        var newStatus = isCompleted ? 4 : 1; // 4 = Завершена, 1 = Новая
        var result = await Api.PutAsync<SubTaskDto>($"/api/tasks/subtasks/{subTask.Id}/status", new { NewStatus = newStatus });
        if (result != null)
        {
            var idx = subTasks.FindIndex(st => st.Id == subTask.Id);
            if (idx >= 0) subTasks[idx] = result;
        }
        StateHasChanged();
    }

