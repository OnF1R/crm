    private async Task CreateDependency()
    {
        if (newDependencyPredecessorId == Guid.Empty)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Выберите задачу для зависимости");
            return;
        }

        var payload = new { PredecessorTaskId = newDependencyPredecessorId, Type = newDependencyType };
        var result = await Api.PostAsync<TaskDependencyDto>($"/api/tasks/tasks/{taskId}/dependencies", payload);
        if (result != null)
        {
            dependencies.Add(result);
            newDependencyPredecessorId = Guid.Empty;
            showDependencyForm = false;
        }
        StateHasChanged();
    }

    private async Task DeleteDependency(Guid dependencyId)
    {
        await Api.DeleteAsync($"/api/tasks/dependencies/{dependencyId}");
        dependencies.RemoveAll(d => d.Id == dependencyId);
        StateHasChanged();
    }

    private string GetDependencyTypeName(string type) => type switch
    {
        "FinishToStart" or "1" => "Finish to Start",
        "StartToStart" or "2" => "Start to Start",
        "FinishToFinish" or "3" => "Finish to Finish",
        _ => type
    };

    private string GetDependencyDirectionText(TaskDependencyDto dependency)
    {
        if (dependency.SuccessorTaskId == taskId)
        {
            return $"Эта задача зависит от: {GetTaskName(dependency.PredecessorTaskId)}";
        }

        if (dependency.PredecessorTaskId == taskId)
        {
            return $"От этой задачи зависит: {GetTaskName(dependency.SuccessorTaskId)}";
        }

        return $"{GetTaskName(dependency.SuccessorTaskId)} зависит от: {GetTaskName(dependency.PredecessorTaskId)}";
    }

    private string GetTaskName(Guid id)
    {
        if (task?.Id == id) return task.Title;
        var relatedTask = availableTasks.FirstOrDefault(t => t.Id == id);
        return relatedTask?.Title ?? "Неизвестная задача";
    }

