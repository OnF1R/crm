    private async Task TriggerFileUpload()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.querySelectorAll('input[type=file]')[document.querySelectorAll('input[type=file]').length-1].click()");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || file.Size == 0) return;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            await Api.UploadFileAsync<AttachmentDto>(
                $"/api/documents/documents/upload?relatedEntityType=Task&relatedEntityId={taskId}",
                file.Name,
                stream,
                file.ContentType,
                null);
        }
        catch { }
        await LoadAttachments();
    }

    private async Task DownloadAttachment(AttachmentDto att)
    {
        try
        {
            var data = await Api.DownloadFileAsync($"/api/documents/documents/{att.Id}/download");
            if (data != null)
            {
                var base64 = Convert.ToBase64String(data);
                await JSRuntime.InvokeVoidAsync("eval", $@"
                    (function() {{
                        var link = document.createElement('a');
                        link.href = 'data:application/octet-stream;base64,{base64}';
                        link.download = '{att.FileName.Replace("'", "\\'")}';
                        link.click();
                    }})()
                ");
            }
        }
        catch { }
    }

    private async Task DeleteAttachment(Guid id)
    {
        await Api.DeleteAsync($"/api/documents/documents/{id}");
        await LoadAttachments();
    }

    private string GetDueDateClass(DateTime dueDate) => dueDate < DateTime.UtcNow ? "text-red-600" : "text-gray-900";

    private List<StatusTransition> GetAllowedTransitions(string currentStatus)
    {
        var status = GetStatusInt(currentStatus);
        return status switch
        {
            1 => [new(2, "В работу", "bg-yellow-400"), new(5, "Отменить", "bg-gray-400")],
            2 => [new(3, "На проверку", "bg-purple-400"), new(1, "Новая", "bg-blue-400"), new(5, "Отменить", "bg-gray-400")],
            3 => [new(4, "Завершена", "bg-green-400"), new(2, "В работу", "bg-yellow-400"), new(5, "Отменить", "bg-gray-400")],
            4 => [new(1, "Переоткрыть", "bg-blue-400")],
            5 => [new(1, "Переоткрыть", "bg-blue-400")],
            _ => []
        };
    }

    private int GetStatusInt(string s) => s switch
