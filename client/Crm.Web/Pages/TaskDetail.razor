    private async Task CreateSubTask()
    {
        if (string.IsNullOrWhiteSpace(newSubTaskTitle)) return;
        var payload = new { Title = newSubTaskTitle, Description = string.IsNullOrWhiteSpace(newSubTaskDesc) ? (string?)null : newSubTaskDesc, DueDate = (DateTime?)null, Priority = newSubTaskPriority, AssignedUserId = authState.User?.Id ?? Guid.Empty, Order = subTasks.Count };
        var result = await Api.PostAsync<SubTaskDto>($"/api/tasks/tasks/{taskId}/subtasks", payload);
        if (result != null)
        {
            subTasks.Add(result);
            newSubTaskTitle = "";
            newSubTaskDesc = "";
