@page "/deals"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Сделки - CRM</PageTitle>

<div class="min-h-screen bg-slate-50/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Сделки</h1>
                <p class="text-surface-500 text-sm mt-1">Управление воронкой продаж</p>
            </div>
            <div class="flex items-center gap-3">
                <button @onclick="OpenRefusalReasonsForm" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200 hover:border-blue-300 hover:bg-blue-50 text-slate-700 hover:text-blue-700 rounded-xl font-medium transition-all duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Причины отказа
                </button>
                <button @onclick="OpenCreateForm" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white rounded-xl font-medium shadow-sm hover:shadow-md transition-all duration-200">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Новая сделка
                </button>
            </div>
        </div>

        <div class="mb-6 bg-white rounded-2xl shadow-sm p-5 ring-1 ring-slate-900/5">
            <div class="flex items-center gap-2 mb-3">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Воронка продаж</span>
            </div>
            <div class="flex rounded-full overflow-hidden h-10 bg-slate-100">
                @foreach (var col in stageColumns)
                {
                    var count = deals.Count(d => GetStageInt(d.Stage) == col.Value);
                    var total = deals.Count;
                    var pct = total > 0 ? (count * 100.0 / total) : 0;
                    @if (count > 0)
                    {
                        <div class="flex items-center justify-center @col.BarClass transition-all duration-500" style="width: @($"{pct}%")">
                            <span class="text-white text-xs font-semibold drop-shadow-sm">@count</span>
                        </div>
                    }
                }
            </div>
            <div class="flex mt-3 gap-1">
                @foreach (var col in stageColumns)
                {
                    var count = deals.Count(d => GetStageInt(d.Stage) == col.Value);
                    <div class="flex-1 text-center">
                        <div class="flex items-center justify-center gap-1.5">
                            <span class="w-2 h-2 rounded-full @col.DotClass"></span>
                            <span class="text-xs font-medium text-slate-600">@col.Label</span>
                        </div>
                        <div class="text-lg font-bold text-slate-800 mt-0.5">@count</div>
                    </div>
                }
            </div>
        </div>

        <div class="mb-5 flex flex-wrap gap-3 items-center">
            <div class="relative flex-1 min-w-[240px] max-w-md">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input @bind="searchQuery" @bind:event="oninput" placeholder="Поиск по названию..." class="w-full pl-10 pr-4 py-2.5 bg-white border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm placeholder-slate-400 transition" />
            </div>
            <select @bind="stageFilter" class="px-4 py-2.5 bg-white border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm text-slate-600 transition">
                <option value="">Все стадии</option>
                <option value="1">Квалификация</option>
                <option value="2">Презентация</option>
                <option value="3">Переговоры</option>
                <option value="4">Договор</option>
                <option value="5">Успех</option>
                <option value="6">Провал</option>
            </select>
            <select @bind="clientFilter" class="px-4 py-2.5 bg-white border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm text-slate-600 transition">
                <option value="">Все клиенты</option>
                @foreach (var c in availableClients)
                {
                    <option value="@c.Id.ToString()">@c.CompanyName</option>
                }
            </select>
        </div>

        @if (showForm)
        {
            <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50" @onclick="CloseForm">
                <div class="bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-sm">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                            </div>
                            <h2 class="text-lg font-bold text-slate-800">@(editingId == null ? "Новая сделка" : "Редактирование сделки")</h2>
                        </div>
                        <button @onclick="CloseForm" class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </div>
                    <div class="space-y-5">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1.5">Название <span class="text-red-400">*</span></label>
                            <input @bind="form.Title" class="w-full px-4 py-2.5 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm placeholder-slate-400 transition" placeholder="Продажа ПО" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1.5">Клиент <span class="text-red-400">*</span></label>
                            <select @bind="form.ClientId" class="w-full px-4 py-2.5 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm text-slate-600 transition">
                                <option value="">-- Выберите клиента --</option>
                                @foreach (var c in availableClients)
                                {
                                    <option value="@c.Id">@c.CompanyName</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1.5">Описание</label>
                            <textarea @bind="form.Description" rows="2" class="w-full px-4 py-2.5 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm placeholder-slate-400 transition" placeholder="Детали сделки"></textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1.5">Сумма</label>
                                <input @bind="form.Amount" type="number" class="w-full px-4 py-2.5 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm placeholder-slate-400 transition" placeholder="0" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1.5">Валюта</label>
                                <select @bind="form.Currency" class="w-full px-4 py-2.5 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm text-slate-600 transition">
                                    <option value="1">RUB</option>
                                    <option value="2">USD</option>
                                    <option value="3">EUR</option>
                                </select>
                            </div>
                        </div>
                        @if (editingId == null)
                        {
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1.5">Стадия</label>
                                <select @bind="form.Stage" class="w-full px-4 py-2.5 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 text-sm text-slate-600 transition">
                                    <option value="1">Квалификация</option>
                                    <option value="2">Презентация</option>
                                    <option value="3">Переговоры</option>
                                    <option value="4">Договор</option>
                                </select>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <div class="p-3 bg-red-50 ring-1 ring-red-200 rounded-xl text-red-700 text-sm flex items-center gap-2">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                @formError
                            </div>
                        }
                        <div class="flex justify-end gap-3 pt-2">
                            <button @onclick="CloseForm" class="px-5 py-2.5 bg-white ring-1 ring-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 font-medium text-sm transition">Отмена</button>
                            <button @onclick="SaveDeal" disabled="@isSubmitting" class="px-5 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white rounded-xl font-medium text-sm shadow-sm hover:shadow-md transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                                @(isSubmitting ? "Сохранение..." : (editingId == null ? "Создать" : "Сохранить"))
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (showRefusalReasonsForm)
        {
            <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50" @onclick="CloseRefusalReasonsForm">
                <div class="bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow-sm">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            </div>
                            <h2 class="text-lg font-bold text-slate-800">Управление причинами отказа</h2>
                        </div>
                        <button @onclick="CloseRefusalReasonsForm" class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </div>

                    <div class="mb-5">
                        <div class="flex gap-2">
                            <input @bind="newRefusalReasonName" @onkeypress="HandleRefusalReasonKeyPress" placeholder="Название новой причины" class="flex-1 px-4 py-2.5 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl focus:ring-2 focus:ring-red-500 text-sm placeholder-slate-400 transition" />
                            <button @onclick="CreateRefusalReason" class="px-5 py-2.5 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white rounded-xl font-medium text-sm shadow-sm hover:shadow-md transition-all duration-200">
                                Добавить
                            </button>
                        </div>
                    </div>

                    @if (isLoadingRefusalReasons)
                    {
                        <div class="flex items-center justify-center py-12">
                            <svg class="w-6 h-6 text-red-500 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                        </div>
                    }
                    else if (refusalReasons.Any())
                    {
                        <div class="space-y-2">
                            @foreach (var reason in refusalReasons)
                            {
                                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl group">
                                    <span class="font-medium text-slate-800">@reason.Name</span>
                                    <div class="flex items-center gap-2">
                                        <button @onclick="() => EditRefusalReason(reason)" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all duration-150 opacity-0 group-hover:opacity-100">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </button>
                                        <button @onclick="() => DeleteRefusalReason(reason.Id)" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all duration-150 opacity-0 group-hover:opacity-100">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-12 text-slate-400">
                            <p>Причины отказа не созданы</p>
                            <p class="text-sm mt-1">Добавьте первую причину для анализа закрытых сделок</p>
                        </div>
                    }
                </div>
            </div>
        }

        @if (isLoading)
        {
            <div class="flex items-center justify-center py-20">
                <div class="flex flex-col items-center gap-3">
                    <svg class="w-8 h-8 text-blue-500 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                    <span class="text-sm text-slate-400">Загрузка сделок...</span>
                </div>
            </div>
        }
        else if (filteredDeals.Any())
        {
            <div class="space-y-3">
                @foreach (var deal in filteredDeals)
                {
                    <div class="bg-white rounded-xl shadow-sm ring-1 ring-slate-900/5 p-4 hover:shadow-md hover:ring-slate-900/10 transition-all duration-200">
                        <div class="flex items-center gap-4">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <h3 class="font-medium text-slate-800 truncate">@deal.Title</h3>
                                    @if (deal.Probability > 0)
                                    {
                                        <span class="text-xs text-slate-400">@deal.Probability%</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(deal.Description))
                                {
                                    <p class="text-sm text-surface-500 mt-0.5 truncate">@deal.Description</p>
                                }
                            </div>

                            <div class="flex items-center gap-3 flex-shrink-0">
                                @if (deal.ClientId != Guid.Empty)
                                {
                                    var clientName = availableClients.FirstOrDefault(c => c.Id == deal.ClientId)?.CompanyName;
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-50 ring-1 ring-slate-200 rounded-lg text-xs font-medium text-slate-600">
                                        <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                                        @(clientName ?? deal.ClientId.ToString().Substring(0, 8) + "...")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">—</span>
                                }

                                <span class="font-semibold text-slate-800 text-sm whitespace-nowrap">
                                    @deal.Amount.ToString("N0") @GetCurrencySymbol(deal.Currency)
                                </span>

                                <div class="relative" @ref="stageDropdownRefs">
                                    <button @onclick="() => ToggleStageMenu(deal.Id)" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full @GetStageColor(deal.Stage) hover:opacity-80 transition cursor-pointer">
                                        <span class="w-1.5 h-1.5 rounded-full @GetStageDotColor(deal.Stage)"></span>
                                        @GetStageName(deal.Stage)
                                        <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                    </button>
                                    @if (openStageMenuId == deal.Id)
                                    {
                                        <div class="absolute right-0 top-9 z-50 bg-white rounded-xl shadow-lg ring-1 ring-slate-900/10 py-1.5 min-w-44">
                                            <div class="px-3 py-1.5 text-xs font-semibold text-slate-400 uppercase tracking-wider">Перейти в стадию</div>
                                            @foreach (var trans in GetAllowedTransitions(deal.Stage))
                                            {
                                                <button @onclick="() => MoveStage(deal.Id, trans.Value)" class="w-full text-left px-3 py-2 text-sm hover:bg-slate-50 flex items-center gap-2.5 transition">
                                                    <span class="w-2 h-2 rounded-full @trans.DotClass"></span>
                                                    <span class="text-slate-700">@trans.Label</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (GetStageInt(deal.Stage) == 6)
                                {
                                    <select value="@(deal.RefusalReasonId?.ToString() ?? "")" @onchange="(e) => SetRefusalReason(deal, e)" class="px-2.5 py-1.5 bg-red-50 ring-1 ring-red-100 rounded-lg text-xs text-red-700 focus:ring-2 focus:ring-red-300">
                                        <option value="">Причина не указана</option>
                                        @foreach (var reason in refusalReasons)
                                        {
                                            <option value="@reason.Id">@reason.Name</option>
                                        }
                                    </select>
                                }

                                <div class="flex items-center gap-1">
                                    <button @onclick="() => OpenEditForm(deal)" class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-blue-600 transition" title="Редактировать">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </button>
                                    <button @onclick="() => DeleteDeal(deal.Id)" class="p-1.5 rounded-lg hover:bg-red-50 text-slate-400 hover:text-red-500 transition" title="Удалить">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-16 bg-white rounded-2xl shadow-sm ring-1 ring-slate-900/5">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                <p class="text-slate-400 text-base font-medium">@(string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(stageFilter) ? "Сделки не найдены" : "Ничего не найдено")</p>
                @if (string.IsNullOrEmpty(searchQuery) && string.IsNullOrEmpty(stageFilter))
                {
                    <button @onclick="OpenCreateForm" class="mt-4 text-blue-500 hover:text-blue-700 text-sm font-medium transition">Создать первую сделку</button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private List<DealDto> deals = new();
    private List<ClientRef> availableClients = new();
    private string searchQuery = "";
    private string stageFilter = "";
    private string clientFilter = "";
    private Guid? openStageMenuId;

    private IEnumerable<DealDto> filteredDeals
    {
        get
        {
            var result = deals.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchQuery))
                result = result.Where(d => d.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(stageFilter))
                result = result.Where(d => GetStageInt(d.Stage) == int.Parse(stageFilter));
            if (!string.IsNullOrWhiteSpace(clientFilter) && Guid.TryParse(clientFilter, out var clientId))
                result = result.Where(d => d.ClientId == clientId);
            return result;
        }
    }

    private bool isLoading = true;
    private bool showForm;
    private bool isSubmitting;
    private string? formError;
    private Guid? editingId;
    private ElementReference stageDropdownRefs;

    // Refusal reasons
    private bool showRefusalReasonsForm;
    private bool isLoadingRefusalReasons;
    private List<RefusalReasonDto> refusalReasons = new();
    private string newRefusalReasonName = "";

    private DealForm form = new();

    private readonly record struct StageColumn(int Value, string Label, string BarClass, string DotClass);
    private readonly List<StageColumn> stageColumns = new()
    {
        new(1, "Квалификация", "bg-blue-500", "bg-blue-400"),
        new(2, "Презентация", "bg-indigo-500", "bg-indigo-400"),
        new(3, "Переговоры", "bg-amber-500", "bg-amber-400"),
        new(4, "Договор", "bg-orange-500", "bg-orange-400"),
        new(5, "Успех", "bg-emerald-500", "bg-emerald-400"),
        new(6, "Провал", "bg-red-500", "bg-red-400")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
        await LoadDeals();
        await LoadRefusalReasons();
    }

    private async Task LoadClients()
    {
        var result = await Api.GetAsync<PagedResult<ClientRef>>("/api/clients/clients");
        if (result != null) availableClients = result.Items.ToList();
    }

    private async Task LoadDeals()
    {
        isLoading = true;
        var result = await Api.GetAsync<PagedResult<DealDto>>("/api/deals/deals");
        if (result != null) deals = result.Items.ToList();
        isLoading = false;
        StateHasChanged();
    }

    private void OpenCreateForm()
    {
        editingId = null;
        form = new DealForm { Stage = 1, Currency = 1, ClientId = "" };
        formError = null;
        showForm = true;
    }

    private void OpenEditForm(DealDto deal)
    {
        editingId = deal.Id;
        form = new DealForm
        {
            Title = deal.Title,
            Description = deal.Description ?? "",
            Amount = deal.Amount,
            Currency = ParseCurrencyInt(deal.Currency),
            ClientId = deal.ClientId.ToString(),
            Stage = GetStageInt(deal.Stage)
        };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveDeal()
    {
        if (string.IsNullOrWhiteSpace(form.Title))
        {
            formError = "Название обязательно";
            return;
        }
        if (string.IsNullOrWhiteSpace(form.ClientId) || !Guid.TryParse(form.ClientId, out var clientId) || clientId == Guid.Empty)
        {
            formError = "Выберите клиента";
            return;
        }

        isSubmitting = true;
        formError = null;
        try
        {
            if (editingId == null)
            {
                var payload = new
                {
                    Title = form.Title,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    Amount = form.Amount,
                    Currency = form.Currency,
                    Stage = form.Stage,
                    ClientId = clientId,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PostAsync<DealDto>("/api/deals/deals", payload);
            }
            else
            {
                var payload = new
                {
                    Title = form.Title,
                    Description = string.IsNullOrWhiteSpace(form.Description) ? (string?)null : form.Description,
                    Amount = form.Amount,
                    Currency = form.Currency,
                    ClientId = clientId,
                    AssignedUserId = AuthState.User?.Id ?? Guid.Empty
                };
                await Api.PutAsync<DealDto>($"/api/deals/deals/{editingId}", payload);
            }
            showForm = false;
            await LoadDeals();
        }
        catch (Exception)
        {
            formError = "Ошибка при сохранении сделки";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task MoveStage(Guid dealId, int newStage)
    {
        openStageMenuId = null;
        await Api.PutAsync<DealDto>($"/api/deals/deals/{dealId}/stage", new { NewStage = newStage });
        await LoadDeals();
    }

    private void ToggleStageMenu(Guid dealId)
    {
        openStageMenuId = openStageMenuId == dealId ? null : dealId;
    }

    private async Task DeleteDeal(Guid id)
    {
        await Api.DeleteAsync($"/api/deals/deals/{id}");
        await LoadDeals();
    }

    private async Task SetRefusalReason(DealDto deal, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        var refusalReasonId = string.IsNullOrWhiteSpace(value) ? (Guid?)null : Guid.Parse(value);
        if (await Api.SetDealRefusalReasonAsync(deal.Id, refusalReasonId))
        {
            await LoadDeals();
        }
    }

    // Refusal reason methods
    private async Task LoadRefusalReasons()
    {
        isLoadingRefusalReasons = true;
        var result = await Api.GetAllRefusalReasonsAsync();
        if (result != null) refusalReasons = result.ToList();
        isLoadingRefusalReasons = false;
        StateHasChanged();
    }

    private void OpenRefusalReasonsForm()
    {
        showRefusalReasonsForm = true;
        if (!refusalReasons.Any())
        {
            LoadRefusalReasons();
        }
    }

    private void CloseRefusalReasonsForm() => showRefusalReasonsForm = false;

    private async Task CreateRefusalReason()
    {
        if (string.IsNullOrWhiteSpace(newRefusalReasonName)) return;

        var result = await Api.CreateRefusalReasonAsync(new CreateRefusalReasonDto(newRefusalReasonName));
        if (result != null)
        {
            newRefusalReasonName = "";
            await LoadRefusalReasons();
        }
    }

    private void HandleRefusalReasonKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CreateRefusalReason();
        }
    }

    private async Task EditRefusalReason(RefusalReasonDto reason)
    {
        var newName = await JSRuntime.InvokeAsync<string?>("prompt", "Введите новое название причины:", reason.Name);
        if (!string.IsNullOrWhiteSpace(newName) && newName != reason.Name)
        {
            await Api.UpdateRefusalReasonAsync(reason.Id, new UpdateRefusalReasonDto(newName, reason.Description));
            await LoadRefusalReasons();
        }
    }

    private async Task DeleteRefusalReason(Guid id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Удалить эту причину отказа?"))
        {
            await Api.DeleteRefusalReasonAsync(id);
            await LoadRefusalReasons();
        }
    }

    private int GetStageInt(string s) => s switch
    {
        "1" or "Квалификация" => 1, "2" or "Презентация" => 2,
        "3" or "Переговоры" => 3, "4" or "Договор" => 4,
        "5" or "ЗакрытиеУспех" => 5, "6" or "ЗакрытиеПровал" => 6, _ => 1
    };

    private int ParseCurrencyInt(string c) => c switch { "1" or "RUB" => 1, "2" or "USD" => 2, "3" or "EUR" => 3, _ => 1 };

    private List<StageTransition> GetAllowedTransitions(string currentStage)
    {
        var stage = GetStageInt(currentStage);
        return stage switch
        {
            1 => [new(2, "Презентация", "bg-indigo-400"), new(6, "Провал", "bg-red-400")],
            2 => [new(3, "Переговоры", "bg-amber-400"), new(1, "Квалификация", "bg-blue-400"), new(6, "Провал", "bg-red-400")],
            3 => [new(4, "Договор", "bg-orange-400"), new(2, "Презентация", "bg-indigo-400"), new(6, "Провал", "bg-red-400")],
            4 => [new(5, "Успех", "bg-emerald-400"), new(6, "Провал", "bg-red-400"), new(3, "Переговоры", "bg-amber-400")],
            5 => [new(1, "Переоткрыть", "bg-blue-400")],
            6 => [new(1, "Переоткрыть", "bg-blue-400")],
            _ => []
        };
    }

    private string GetStageName(string stage) => stage switch
    {
        "Квалификация" or "1" => "Квалификация", "Презентация" or "2" => "Презентация",
        "Переговоры" or "3" => "Переговоры", "Договор" or "4" => "Договор",
        "ЗакрытиеУспех" or "5" => "Успех", "ЗакрытиеПровал" or "6" => "Провал",
        _ => stage
    };

    private string GetStageColor(string stage) => stage switch
    {
        "Квалификация" or "1" => "bg-blue-50 text-blue-700 ring-1 ring-blue-200",
        "Презентация" or "2" => "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-200",
        "Переговоры" or "3" => "bg-amber-50 text-amber-700 ring-1 ring-amber-200",
        "Договор" or "4" => "bg-orange-50 text-orange-700 ring-1 ring-orange-200",
        "ЗакрытиеУспех" or "5" => "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200",
        "ЗакрытиеПровал" or "6" => "bg-red-50 text-red-700 ring-1 ring-red-200",
        _ => "bg-slate-50 text-slate-600 ring-1 ring-slate-200"
    };

    private string GetStageDotColor(string stage) => stage switch
    {
        "Квалификация" or "1" => "bg-blue-500",
        "Презентация" or "2" => "bg-indigo-500",
        "Переговоры" or "3" => "bg-amber-500",
        "Договор" or "4" => "bg-orange-500",
        "ЗакрытиеУспех" or "5" => "bg-emerald-500",
        "ЗакрытиеПровал" or "6" => "bg-red-500",
        _ => "bg-slate-500"
    };

    private string GetCurrencySymbol(string currency) => currency switch
    {
        "RUB" or "1" => "₽", "USD" or "2" => "$", "EUR" or "3" => "€", _ => currency
    };

    private string GetCurrencyName(string currency) => currency switch
    {
        "RUB" or "1" => "₽", "USD" or "2" => "$", "EUR" or "3" => "€", _ => currency
    };

    private record StageTransition(int Value, string Label, string DotClass);
    private class DealForm
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ClientId { get; set; } = "";
        public decimal Amount { get; set; }
        public int Currency { get; set; } = 1;
        public int Stage { get; set; } = 1;
    }

    private record DealDto(Guid Id, string Title, string? Description, decimal Amount, string Currency, string Stage, int Probability, Guid ClientId, Guid AssignedUserId, DateTime? ClosedAt, DateTime CreatedAt, Guid? RefusalReasonId);
    private record ClientRef(Guid Id, string CompanyName);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
