@page "/dashboard"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Дашборд - CRM</PageTitle>

<div class="min-h-screen">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-surface-900">Дашборд</h1>
        <p class="text-surface-500 mt-1">Добро пожаловать, @authState.User?.FirstName</p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        @if (isLoading)
        {
            @for (var i = 0; i < 4; i++)
            {
                <div class="bg-white rounded-2xl shadow-soft p-5 transition-shadow duration-200 hover:shadow-soft-md">
                    <div class="animate-pulse">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-xl bg-surface-100"></div>
                            <div class="h-3 w-20 bg-surface-100 rounded"></div>
                        </div>
                        <div class="h-8 w-24 bg-surface-100 rounded"></div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white rounded-2xl shadow-soft p-5 transition-shadow duration-200 hover:shadow-soft-md">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-brand-600">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                    </div>
                    <span class="text-sm text-surface-500">Клиенты</span>
                </div>
                <p class="text-2xl font-bold text-surface-900">@clientCount</p>
            </div>

            <div class="bg-white rounded-2xl shadow-soft p-5 transition-shadow duration-200 hover:shadow-soft-md">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-info-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-info-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.35c0 .621-.504 1.125-1.125 1.125H4.875c-.621 0-1.125-.504-1.125-1.125v-4.35m16.5 0V9.15m0 5.25H3.75m16.5 0H3.75m0 0V9.15m0 5.25c0-.621.504-1.125 1.125-1.125h16.5c.621 0 1.125.504 1.125 1.125V9.15m-18 0L5.25 3.75h13.5l2.25 5.4" />
                        </svg>
                    </div>
                    <span class="text-sm text-surface-500">Сделки</span>
                </div>
                <p class="text-2xl font-bold text-surface-900">@activeDealCount</p>
                <p class="text-xs text-surface-400 mt-1">@totalDealAmount.ToString("N0") ₽</p>
            </div>

            <div class="bg-white rounded-2xl shadow-soft p-5 transition-shadow duration-200 hover:shadow-soft-md">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-success-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-success-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                    </div>
                    <span class="text-sm text-surface-500">Задачи</span>
                </div>
                <p class="text-2xl font-bold text-surface-900">@taskCount</p>
                <p class="text-xs text-surface-400 mt-1">Незавершённых: @pendingTaskCount</p>
            </div>

            <div class="bg-white rounded-2xl shadow-soft p-5 transition-shadow duration-200 hover:shadow-soft-md">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-warning-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-warning-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5M12 3a5.25 5.25 0 015.25 5.25c0 3.75 1.5 6 3 7.5H3.75c1.5-1.5 3-3.75 3-7.5A5.25 5.25 0 0112 3zM8.25 18.75h7.5M10.5 21h3" />
                        </svg>
                    </div>
                    <span class="text-sm text-surface-500">Уведомления</span>
                </div>
                <p class="text-2xl font-bold text-surface-900">@unreadNotificationCount</p>
                <p class="text-xs text-surface-400 mt-1">Непрочитанных</p>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="bg-white rounded-2xl shadow-soft p-5 transition-shadow duration-200 hover:shadow-soft-md">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-base font-semibold text-surface-900">Последние сделки</h2>
                <NavLink href="deals">
                    <span class="text-xs font-medium text-brand-600 hover:text-brand-700 transition-colors">Все сделки</span>
                </NavLink>
            </div>
            @if (isLoading)
            {
                <div class="space-y-3">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="flex items-center justify-between py-2.5 animate-pulse">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-surface-100"></div>
                                <div>
                                    <div class="h-3 w-32 bg-surface-100 rounded mb-1.5"></div>
                                    <div class="h-2.5 w-20 bg-surface-100 rounded"></div>
                                </div>
                            </div>
                            <div class="h-5 w-16 bg-surface-100 rounded-full"></div>
                        </div>
                    }
                </div>
            }
            else if (recentDeals.Any())
            {
                <div class="space-y-1">
                    @foreach (var deal in recentDeals.Take(5))
                    {
                        <div class="flex items-center justify-between py-2.5 px-2 rounded-xl hover:bg-surface-50 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-info-50 flex items-center justify-center flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-info-500">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.35c0 .621-.504 1.125-1.125 1.125H4.875c-.621 0-1.125-.504-1.125-1.125v-4.35m16.5 0V9.15m0 5.25H3.75m16.5 0H3.75m0 0V9.15m0 5.25c0-.621.504-1.125 1.125-1.125h16.5c.621 0 1.125.504 1.125 1.125V9.15m-18 0L5.25 3.75h13.5l2.25 5.4" />
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-surface-900">@deal.Title</p>
                                    <p class="text-xs text-surface-400">@deal.Amount.ToString("N0") @GetCurrencySymbol(deal.Currency)</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <span class="rounded-full text-xs px-2.5 py-0.5 @GetStageColor(deal.Stage)">@GetStageName(deal.Stage)</span>
                                <span class="text-xs text-surface-400">@deal.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-surface-400 text-sm py-4 text-center">Нет сделок</p>
            }
        </div>

        <div class="bg-white rounded-2xl shadow-soft p-5 transition-shadow duration-200 hover:shadow-soft-md">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-base font-semibold text-surface-900">Последние задачи</h2>
                <NavLink href="tasks">
                    <span class="text-xs font-medium text-brand-600 hover:text-brand-700 transition-colors">Все задачи</span>
                </NavLink>
            </div>
            @if (isLoading)
            {
                <div class="space-y-3">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="flex items-center justify-between py-2.5 animate-pulse">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-surface-100"></div>
                                <div>
                                    <div class="h-3 w-32 bg-surface-100 rounded mb-1.5"></div>
                                    <div class="h-2.5 w-16 bg-surface-100 rounded-full"></div>
                                </div>
                            </div>
                            <div class="h-5 w-20 bg-surface-100 rounded-full"></div>
                        </div>
                    }
                </div>
            }
            else if (recentTasks.Any())
            {
                <div class="space-y-1">
                    @foreach (var task in recentTasks.Take(5))
                    {
                        <div class="flex items-center justify-between py-2.5 px-2 rounded-xl hover:bg-surface-50 transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-success-50 flex items-center justify-center flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-success-500">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-2.485-.036H6.598a48.42 48.42 0 00-2.485.036c-1.131.094-1.976 1.057-1.976 2.192V16.5A2.25 2.25 0 004.5 18.75h3" />
                                    </svg>
                                </div>
                                <div class="flex items-center gap-2">
                                    <p class="text-sm font-medium text-surface-900">@task.Title</p>
                                    <span class="rounded-full text-xs px-2 py-0.5 @GetTaskPriorityColor(task.Priority)">@GetTaskPriorityName(task.Priority)</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <span class="rounded-full text-xs px-2.5 py-0.5 @GetTaskStatusColor(task.Status)">@GetTaskStatusName(task.Status)</span>
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="text-xs text-surface-400">@task.DueDate.Value.ToLocalTime().ToString("dd.MM")</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-surface-400 text-sm py-4 text-center">Нет задач</p>
            }
        </div>
    </div>
</div>

@code {
    [Inject] private AuthState authState { get; set; } = default!;
    [Inject] private ApiClient Api { get; set; } = default!;

    private bool isLoading = true;
    private int clientCount;
    private int activeDealCount;
    private decimal totalDealAmount;
    private int taskCount;
    private int pendingTaskCount;
    private int unreadNotificationCount;

    private List<DealDto> recentDeals = new();
    private List<TaskDto> recentTasks = new();

    protected override async Task OnInitializedAsync()
    {
        var userId = authState.User?.Id ?? Guid.Empty;
        if (userId == Guid.Empty) return;

        var tasks = new List<Task>();

        tasks.Add(LoadClientsAsync());
        tasks.Add(LoadDealsAsync());
        tasks.Add(LoadTasksAsync());
        tasks.Add(LoadUnreadNotificationsAsync(userId));

        await Task.WhenAll(tasks);
        isLoading = false;
    }

    private async Task LoadClientsAsync()
    {
        try
        {
            var result = await Api.GetAsync<PagedResult<ClientDto>>("/api/clients/clients");
            if (result != null) clientCount = result.TotalCount;
        }
        catch { }
    }

    private async Task LoadDealsAsync()
    {
        try
        {
            var result = await Api.GetAsync<PagedResult<DealDto>>("/api/deals/deals");
            if (result != null)
            {
                recentDeals = result.Items
                    .OrderByDescending(d => d.CreatedAt)
                    .ToList();
                activeDealCount = result.Items.Count(d => IsActiveDealStage(d.Stage));
                totalDealAmount = result.Items
                    .Where(d => IsActiveDealStage(d.Stage))
                    .Where(d => d.Currency == "1" || d.Currency == "RUB")
                    .Sum(d => d.Amount);
            }
        }
        catch { }
    }
    private async Task LoadUnreadNotificationsAsync(Guid userId)
    {
        try
        {
            var result = await Api.GetAsync<UnreadCountDto>($"/api/notifications/users/{userId}/notifications/unread-count");
            if (result != null) unreadNotificationCount = result.Count;
        }
        catch { }
    }

    private string GetStageName(string stage) => stage switch
    {
        "Квалификация" or "1" => "Квалификация", "Презентация" or "2" => "Презентация",
        "Переговоры" or "3" => "Переговоры", "Договор" or "4" => "Договор",
        "ЗакрытиеУспех" or "5" => "Успех", "ЗакрытиеПровал" or "6" => "Провал",
        _ => stage
    };

    private string GetStageColor(string stage) => stage switch
    {
        "Квалификация" or "1" => "bg-blue-100 text-blue-700",
        "Презентация" or "2" => "bg-indigo-100 text-indigo-700",
        "Переговоры" or "3" => "bg-yellow-100 text-yellow-700",
        "Договор" or "4" => "bg-orange-100 text-orange-700",
        "ЗакрытиеУспех" or "5" => "bg-green-100 text-green-700",
        "ЗакрытиеПровал" or "6" => "bg-red-100 text-red-700",
        _ => "bg-gray-100 text-gray-600"
    };

    private async Task LoadTasksAsync()
    {
        try
        {
            var result = await Api.GetAsync<PagedResult<TaskDto>>("/api/tasks/tasks");
            if (result != null)
            {
                recentTasks = result.Items
                    .OrderByDescending(t => t.CreatedAt)
                    .ToList();
                taskCount = result.TotalCount;
                pendingTaskCount = result.Items.Count(t => IsOpenTaskStatus(t.Status));
            }
        }
        catch { }
    }
    private static bool IsClosedDealStage(string stage) => stage?.Trim() is
        "5" or "ЗакрытиеУспех" or "ClosedWon" or "Won" or "Success" or
        "6" or "ЗакрытиеПровал" or "ClosedLost" or "Lost" or "Fail" or "Failed";

    private static bool IsActiveDealStage(string stage) => !IsClosedDealStage(stage);

    private static bool IsCompletedTaskStatus(string status) => status?.Trim() is
        "4" or "Завершена" or "Done" or "Completed";

    private static bool IsOpenTaskStatus(string status) =>
        !IsCompletedTaskStatus(status) && !IsCanceledTaskStatus(status);

    private static bool IsCanceledTaskStatus(string status) => status?.Trim() is
        "5" or "Отменена" or "Canceled" or "Cancelled";

    private string GetCurrencySymbol(string currency) => currency switch
    {
        "RUB" or "1" => "₽", "USD" or "2" => "$", "EUR" or "3" => "€", _ => currency
    };

    private string GetTaskPriorityName(string p) => p switch
    {
        "1" or "Низкий" => "Низкий", "2" or "Средний" => "Средний",
        "3" or "Высокий" => "Высокий", "4" or "Критический" => "Критический", _ => p
    };

    private string GetTaskPriorityColor(string p) => p switch
    {
        "4" or "Критический" => "bg-red-100 text-red-700",
        "3" or "Высокий" => "bg-orange-100 text-orange-700",
        "2" or "Средний" => "bg-yellow-100 text-yellow-700",
        "1" or "Низкий" => "bg-green-100 text-green-700",
        _ => "bg-gray-100 text-gray-600"
    };

    private string GetTaskStatusName(string s) => s switch
    {
        "1" or "Новая" => "Новая", "2" or "ВРаботе" => "В работе",
        "3" or "НаПроверке" => "На проверке", "4" or "Завершена" => "Завершена",
        "5" or "Отменена" => "Отменена", _ => s
    };

    private string GetTaskStatusColor(string s) => s switch
    {
        "1" or "Новая" => "bg-blue-100 text-blue-700",
        "2" or "ВРаботе" => "bg-yellow-100 text-yellow-700",
        "3" or "НаПроверке" => "bg-purple-100 text-purple-700",
        "4" or "Завершена" => "bg-green-100 text-green-700",
        "5" or "Отменена" => "bg-gray-100 text-gray-600",
        _ => "bg-gray-100 text-gray-600"
    };

    private record ClientDto(Guid Id, string CompanyName, string? Description, string? AvatarUrl, string? Inn, string? Website, string Industry, string Status, Guid AssignedUserId, DateTime CreatedAt);
    private record DealDto(Guid Id, string Title, string? Description, decimal Amount, string Currency, string Stage, int Probability, Guid ClientId, Guid AssignedUserId, DateTime? ClosedAt, DateTime CreatedAt);
    private record TaskDto(Guid Id, string Title, string? Description, DateTime? DueDate, string Priority, string Status, Guid AssignedUserId, string? RelatedEntityType, Guid? RelatedEntityId, DateTime CreatedAt);
    private record UnreadCountDto(int Count);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
