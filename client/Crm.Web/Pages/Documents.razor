@page "/documents"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Документы - CRM</PageTitle>

<div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Документы</h1>
            <p class="text-sm text-gray-400 mt-0.5">Управление файлами и документами</p>
        </div>
        <button @onclick="TriggerUpload" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V4.5m0 0L7.5 9m4.5-4.5L16.5 9M3 15.75v2.25A2.25 2.25 0 005.25 20.25h13.5A2.25 2.25 0 0021 18v-2.25" />
            </svg>
            Загрузить
        </button>
        <InputFile OnChange="OnFileSelected" class="hidden" />
    </div>

    @if (!isUploading && !isLoading && !documents.Any() && string.IsNullOrEmpty(uploadError))
    {
        <div class="mb-6 border-2 border-dashed border-gray-200 rounded-2xl p-10 text-center hover:border-blue-300 hover:bg-blue-50/30 transition cursor-pointer" @onclick="TriggerUpload">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-gray-300 mx-auto mb-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V4.5m0 0L7.5 9m4.5-4.5L16.5 9M3 15.75v2.25A2.25 2.25 0 005.25 20.25h13.5A2.25 2.25 0 0021 18v-2.25" />
            </svg>
            <p class="text-sm font-medium text-gray-600">Перетащите файлы сюда или нажмите для загрузки</p>
            <p class="text-xs text-gray-400 mt-1">Максимум 100 МБ на файл</p>
        </div>
    }

    @if (isUploading)
    {
        <div class="mb-6 bg-white rounded-2xl shadow-sm border border-blue-100 p-5 flex items-center gap-3">
            <svg class="animate-spin w-5 h-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <p class="text-sm text-blue-700 font-medium">Загрузка файла...</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(uploadError))
    {
        <div class="mb-6 flex items-center gap-2 p-4 bg-red-50 border border-red-100 rounded-2xl text-red-700 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            @uploadError
        </div>
    }

    @if (isLoading)
    {
        <div class="bg-white rounded-2xl shadow-sm p-12 text-center">
            <div class="inline-flex items-center gap-2 text-gray-400">
                <svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Загрузка документов...
            </div>
        </div>
    }
    else if (documents.Any())
    {
        <div class="space-y-3">
            @foreach (var doc in documents)
            {
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 p-5 flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4 flex-1 min-w-0">
                        <div class="w-11 h-11 rounded-xl @GetFileTypeBg(doc.ContentType) flex items-center justify-center flex-shrink-0">
                            @GetFileIconSvg(doc.ContentType)
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-semibold text-gray-900 text-sm truncate">@doc.FileName</h3>
                            <div class="flex items-center gap-3 mt-1">
                                <span class="text-xs text-gray-400">@FormatFileSize(doc.Size)</span>
                                <span class="text-xs text-gray-300">|</span>
                                <span class="text-xs text-gray-400">@doc.ContentType</span>
                                @if (doc.RelatedEntityType != null)
                                {
                                    <span class="text-xs text-gray-300">|</span>
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-xs font-medium">
                                        @doc.RelatedEntityType
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <span class="text-xs text-gray-400 mr-3">@doc.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        <button @onclick="() => DownloadDocument(doc)" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gray-100 text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition" title="Скачать">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75v12m0 0l4.5-4.5M12 15.75l-4.5-4.5M3 15.75v2.25A2.25 2.25 0 005.25 20.25h13.5A2.25 2.25 0 0021 18v-2.25" />
                            </svg>
                        </button>
                        <button @onclick="() => DeleteDocument(doc.Id)" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-gray-100 text-gray-600 hover:bg-red-50 hover:text-red-600 transition" title="Удалить">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.7 48.7 0 00-7.5 0" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-16 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 80 80" stroke-width="1" stroke="currentColor" class="w-20 h-20 text-gray-200 mx-auto mb-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25h-5a2.25 2.25 0 00-2.25 2.25v47.5a2.25 2.25 0 002.25 2.25h35a2.25 2.25 0 002.25-2.25V27.75L42 14.25H19.5z" transform="scale(1.2) translate(2,4)" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v9.75h9.75" transform="scale(1.2) translate(2,4)" />
            </svg>
            <h3 class="text-gray-900 font-semibold mb-1">Нет документов</h3>
            <p class="text-sm text-gray-400 mb-4">Загрузите первый документ для начала работы</p>
            <button @onclick="TriggerUpload" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                </svg>
                Загрузить документ
            </button>
        </div>
    }
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private List<DocumentDto> documents = new();
    private bool isLoading = true;
    private bool isUploading;
    private string? uploadError;

    protected override async Task OnInitializedAsync() => await LoadDocuments();

    private async Task LoadDocuments()
    {
        isLoading = true;
        var result = await Api.GetAsync<PagedResult<DocumentDto>>("/api/documents/documents");
        if (result != null) documents = result.Items.ToList();
        isLoading = false;
        StateHasChanged();
    }

    private async Task TriggerUpload()
    {
        uploadError = null;
        await JSRuntime.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || file.Size == 0) return;

        isUploading = true;
        uploadError = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            var result = await Api.UploadFileAsync<DocumentDto>(
                "/api/documents/documents/upload",
                file.Name,
                stream,
                file.ContentType,
                null);

            await LoadDocuments();
        }
        catch (Exception)
        {
            uploadError = "Ошибка при загрузке файла";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadDocument(DocumentDto doc)
    {
        try
        {
            var data = await Api.DownloadFileAsync($"/api/documents/documents/{doc.Id}/download");
            if (data != null)
            {
                var base64 = Convert.ToBase64String(data);
                await JSRuntime.InvokeVoidAsync("eval", $@"
                    (function() {{
                        var link = document.createElement('a');
                        link.href = 'data:application/octet-stream;base64,{base64}';
                        link.download = '{doc.FileName.Replace("'", "\\'")}';
                        link.click();
                    }})()
                ");
            }
        }
        catch { }
    }

    private async Task DeleteDocument(Guid id)
    {
        await Api.DeleteAsync($"/api/documents/documents/{id}");
        await LoadDocuments();
    }

    private string GetFileTypeBg(string contentType) => contentType switch
    {
        var t when t.Contains("pdf") => "bg-red-50",
        var t when t.Contains("image") => "bg-emerald-50",
        var t when t.Contains("word") || t.Contains("document") => "bg-blue-50",
        var t when t.Contains("sheet") || t.Contains("excel") => "bg-green-50",
        var t when t.Contains("presentation") || t.Contains("powerpoint") => "bg-orange-50",
        var t when t.Contains("zip") || t.Contains("archive") => "bg-yellow-50",
        _ => "bg-gray-50"
    };

    private string GetFileTypeColor(string contentType) => contentType switch
    {
        var t when t.Contains("pdf") => "text-red-500",
        var t when t.Contains("image") => "text-emerald-500",
        var t when t.Contains("word") || t.Contains("document") => "text-blue-500",
        var t when t.Contains("sheet") || t.Contains("excel") => "text-green-500",
        var t when t.Contains("presentation") || t.Contains("powerpoint") => "text-orange-500",
        var t when t.Contains("zip") || t.Contains("archive") => "text-yellow-600",
        _ => "text-gray-400"
    };

    private MarkupString GetFileIconSvg(string contentType)
    {
        var color = GetFileTypeColor(contentType);
        var isPdf = contentType.Contains("pdf");
        var isImage = contentType.Contains("image");
        var isWord = contentType.Contains("word") || contentType.Contains("document");
        var isSheet = contentType.Contains("sheet") || contentType.Contains("excel");
        var isArchive = contentType.Contains("zip") || contentType.Contains("archive");

        var svg = isPdf ? $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.5 14.25v2.625a2.625 2.625 0 01-2.625 2.625h-13.5A2.625 2.625 0 01.75 16.875V3.375A2.625 2.625 0 013.375.75h9.586c.696 0 1.364.277 1.857.77l3.162 3.162c.493.493.77 1.16.77 1.857v7.711z\" /></svg>"
            : isImage ? $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159M1.5 4.875a1.125 1.125 0 011.125-1.125h14.25a1.125 1.125 0 011.125 1.125v10.5a1.125 1.125 0 01-1.125 1.125H2.625a1.125 1.125 0 01-1.125-1.125V4.875z\" /></svg>"
            : isWord ? $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.5 14.25v2.625a2.625 2.625 0 01-2.625 2.625h-13.5A2.625 2.625 0 01.75 16.875V3.375A2.625 2.625 0 013.375.75h9.586c.696 0 1.364.277 1.857.77l3.162 3.162c.493.493.77 1.16.77 1.857v7.711z\" /><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 9.75h5.25M6 12.75h5.25M6 6.75h5.25\" /></svg>"
            : isSheet ? $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3.375 19.5h13.5a2.25 2.25 0 002.25-2.25V6.375a2.25 2.25 0 00-2.25-2.25H3.375a2.25 2.25 0 00-2.25 2.25v10.875a2.25 2.25 0 002.25 2.25zM6.75 4.5v15M13.5 4.5v15M1.5 9.75h18M1.5 15h18\" /></svg>"
            : isArchive ? $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h15M5.25 7.5V3.375a1.125 1.125 0 011.125-1.125h7.5a1.125 1.125 0 011.125 1.125V7.5\" /></svg>"
            : $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.5 14.25v2.625a2.625 2.625 0 01-2.625 2.625h-13.5A2.625 2.625 0 01.75 16.875V3.375A2.625 2.625 0 013.375.75h9.586c.696 0 1.364.277 1.857.77l3.162 3.162c.493.493.77 1.16.77 1.857v7.711z\" /></svg>";

        return new MarkupString(svg);
    }

    private string FormatFileSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} Б",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} КБ",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):F1} МБ",
        _ => $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} ГБ"
    };

    private record DocumentDto(Guid Id, string FileName, string ContentType, long Size, Guid UploadedByUserId, string? RelatedEntityType, Guid? RelatedEntityId, DateTime CreatedAt);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}


