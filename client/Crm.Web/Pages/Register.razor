@page "/register"
@using Crm.Web.Auth

<PageTitle>Регистрация - CRM</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg p-8">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-900">Регистрация</h1>
                <p class="text-gray-500 mt-2">Создайте новый аккаунт</p>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">@error</div>
            }
            @if (!string.IsNullOrEmpty(successMsg))
            {
                <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm">@successMsg</div>
            }

            <EditForm Model="regModel" OnValidSubmit="HandleRegister" FormName="register">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" @bind="regModel.Email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Имя</label>
                            <input @bind="regModel.FirstName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Фамилия</label>
                            <input @bind="regModel.LastName" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Пароль</label>
                        <input type="password" @bind="regModel.Password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    </div>
                    <button type="submit" disabled="@isLoading" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition disabled:opacity-50">
                        @(isLoading ? "Регистрация..." : "Зарегистрироваться")
                    </button>
                </div>
            </EditForm>

            <div class="mt-6 text-center">
                <a href="/login" class="text-blue-600 hover:underline text-sm">Уже есть аккаунт? Войти</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthState authState { get; set; } = default!;

    private RegisterModel regModel = new();
    private string? error;
    private string? successMsg;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (authState.IsAuthenticated)
            Nav.NavigateTo("/dashboard", true);
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        error = null;
        successMsg = null;
        try
        {
            var success = await AuthService.RegisterAsync(regModel.Email, regModel.Password, regModel.FirstName, regModel.LastName);
            if (success)
            {
                var loginSuccess = await AuthService.LoginAsync(regModel.Email, regModel.Password);
                if (loginSuccess)
                    Nav.NavigateTo("/dashboard", true);
                else
                    successMsg = "Аккаунт создан! Войдите с вашими данными.";
            }
            else
            {
                error = "Ошибка регистрации. Попробуйте снова.";
            }
        }
        catch (Exception)
        {
            error = "Ошибка подключения к серверу";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class RegisterModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}
