    private List<KeyValuePair<string, int>> GetReportChartEntries(ReportDto report)
    {
        var entries = report.Type switch
        {
            "1" => ParseDealsReport(report.Data).ByStage,
            "2" => ParseClientsReport(report.Data).ByStatus,
            "3" => ParseTasksReport(report.Data).ByStatus,
            _ => new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
        };

        return entries
            .Where(x => x.Value > 0)
            .OrderByDescending(x => x.Value)
            .Take(6)
            .ToList();
    }

    private static string FormatDataLabel(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Не указано";
        }

        var normalized = value.Trim();
        return normalized switch
        {
            "ВРаботе" or "InProgress" or "InProgressStatus" => "В работе",
            "ЗакрытиеУспех" or "ClosedWon" or "Won" or "Success" => "Закрытие: успех",
            "ЗакрытиеПровал" or "ClosedLost" or "Lost" or "Fail" or "Failed" => "Закрытие: провал",
            "Новый" or "New" => "Новый",
            "Активный" or "Active" => "Активный",
            "Неактивный" or "Inactive" => "Неактивный",
            "Ожидает" or "Pending" => "Ожидает",
            "Выполнено" or "Completed" or "Done" => "Выполнено",
            "Просрочено" or "Overdue" => "Просрочено",
            "Квалификация" or "Qualification" => "Квалификация",
            "Презентация" or "Presentation" => "Презентация",
            "Переговоры" or "Negotiation" or "Negotiations" => "Переговоры",
            "Договор" or "Contract" => "Договор",
            _ => SplitReadableWords(normalized)
        };
    }

    private static string SplitReadableWords(string value)
    {
        var cleaned = value.Replace('_', ' ').Replace('-', ' ');
        var result = new List<char>(cleaned.Length + 8);

        for (var i = 0; i < cleaned.Length; i++)
        {
            var current = cleaned[i];
            var previous = i > 0 ? cleaned[i - 1] : '\0';
            var next = i + 1 < cleaned.Length ? cleaned[i + 1] : '\0';

            if (i > 0 &&
                !char.IsWhiteSpace(previous) &&
                char.IsUpper(current) &&
                (char.IsLower(previous) || (char.IsUpper(previous) && char.IsLower(next))))
            {
                result.Add(' ');
            }

            result.Add(current);
        }

        return new string(result.ToArray()).Trim();
    }

