    private static string FormatParametersPeriod(string parameters)
    {
        if (string.IsNullOrWhiteSpace(parameters))
        {
            return "Не указан";
        }

        try
        {
            using var document = JsonDocument.Parse(parameters);
            if (document.RootElement.TryGetProperty("from", out var fromElement) &&
                document.RootElement.TryGetProperty("to", out var toElement))
            {
                if (fromElement.TryGetDateTime(out var from) && toElement.TryGetDateTime(out var to))
                {
                    return $"{from:dd.MM.yyyy} - {to:dd.MM.yyyy}";
                }
            }
        }
        catch
        {
        }

        return "Не указан";
    }

    private static int ReadInt(JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var element))
        {
            return 0;
        }

        return element.ValueKind switch
        {
            JsonValueKind.Number when element.TryGetInt32(out var value) => value,
            JsonValueKind.String when int.TryParse(element.GetString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) => parsed,
            JsonValueKind.True => 1,
            JsonValueKind.False => 0,
            _ => 0
        };
    }

    private static decimal ReadDecimal(JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var element))
        {
            return 0m;
        }

        return element.ValueKind switch
        {
            JsonValueKind.Number when element.TryGetDecimal(out var value) => value,
            JsonValueKind.String when decimal.TryParse(element.GetString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed) => parsed,
            _ => 0m
        };
    }

    private static Dictionary<string, int> ReadIntDictionary(JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var element) || element.ValueKind != JsonValueKind.Object)
        {
            return new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        }

        var result = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var entry in element.EnumerateObject())
        {
            var value = entry.Value.ValueKind switch
            {
                JsonValueKind.Number when entry.Value.TryGetInt32(out var intValue) => intValue,
                JsonValueKind.Number when entry.Value.TryGetInt64(out var longValue) => (int)Math.Clamp(longValue, int.MinValue, int.MaxValue),
                JsonValueKind.String when int.TryParse(entry.Value.GetString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedValue) => parsedValue,
                _ => 0
            };

            result[entry.Name] = value;
        }

        return result;
    }

