    private static string GetBarPercent(int value, int max)
    {
        if (max <= 0)
        {
            return "0";
        }

        var percent = value * 100.0 / max;
        percent = Math.Clamp(percent, 0, 100);
        return percent.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string BuildParametersJson(DateTime fromUtc, DateTime toUtc)
    {
        return JsonSerializer.Serialize(new
        {
            from = fromUtc.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture),
            to = toUtc.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture)
        });
    }

    private static string BuildSparklinePoints(Dictionary<string, int> values, int width, int height)
    {
        if (values.Count == 0)
        {
            return string.Empty;
        }

        var ordered = values.ToList();
        var maxValue = Math.Max(1, ordered.Max(x => x.Value));
        var left = 12.0;
        var top = 16.0;
        var right = width - 12.0;
        var bottom = height - 20.0;
        var usableWidth = Math.Max(1.0, right - left);
        var usableHeight = Math.Max(1.0, bottom - top);

        if (ordered.Count == 1)
        {
            var y = bottom - ordered[0].Value * usableHeight / maxValue;
            return $"{left.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)} {right.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)}";
        }

        var points = new List<(double X, double Y)>();
        for (var i = 0; i < ordered.Count; i++)
        {
            var x = left + (usableWidth * i / (ordered.Count - 1));
            var y = bottom - ordered[i].Value * usableHeight / maxValue;
            points.Add((x, y));
        }

        return string.Join(" ", points.Select(p => $"{p.X.ToString("0.##", CultureInfo.InvariantCulture)},{p.Y.ToString("0.##", CultureInfo.InvariantCulture)}"));
    }

    private static List<(double X, double Y)> BuildSparklinePointsWithIndex(Dictionary<string, int> values, int width, int height)
    {
        if (values.Count == 0)
        {
            return new List<(double X, double Y)>();
        }

        var ordered = values.ToList();
        var maxValue = Math.Max(1, ordered.Max(x => x.Value));
        var left = 12.0;
        var top = 16.0;
        var right = width - 12.0;
        var bottom = height - 20.0;
        var usableWidth = Math.Max(1.0, right - left);
        var usableHeight = Math.Max(1.0, bottom - top);

        var result = new List<(double X, double Y)>();
        for (var i = 0; i < ordered.Count; i++)
        {
            var x = ordered.Count == 1 ? width / 2.0 : left + (usableWidth * i / (ordered.Count - 1));
            var y = bottom - ordered[i].Value * usableHeight / maxValue;
            result.Add((x, y));
        }

        return result;
    }

