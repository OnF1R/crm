@page "/analytics"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Аналитика - CRM</PageTitle>

<div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Аналитика</h1>
            <p class="text-sm text-gray-400 mt-0.5">Отчёты и статистика</p>
        </div>
        <button @onclick="OpenReportForm" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H19A7.5 7.5 0 0011.5 3v6.5a1 1 0 001 1z" />
            </svg>
            Сформировать отчёт
        </button>
    </div>

    @if (showReportForm)
    {
        <div class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center z-50" @onclick="CloseReportForm">
            <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md" @onclick:stopPropagation>
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H19A7.5 7.5 0 0011.5 3v6.5a1 1 0 001 1z" />
                        </svg>
                    </div>
                    <h2 class="text-lg font-bold text-gray-900">Новый отчёт</h2>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Тип отчёта</label>
                        <select @bind="reportForm.Type" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition text-sm bg-white">
                            <option value="1">Сделки</option>
                            <option value="2">Клиенты</option>
                            <option value="3">Задачи</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Параметры (JSON)</label>
                        <textarea @bind="reportForm.Parameters" rows="3" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition text-sm font-mono resize-none" placeholder='{"period": "month"}'></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(reportError))
                    {
                        <div class="flex items-center gap-2 p-3 bg-red-50 border border-red-100 rounded-xl text-red-700 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 flex-shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                            </svg>
                            @reportError
                        </div>
                    }
                    <div class="flex justify-end gap-3 pt-2">
                        <button @onclick="CloseReportForm" class="px-4 py-2.5 rounded-xl bg-gray-100 text-gray-700 hover:bg-gray-200 transition text-sm font-medium">Отмена</button>
                        <button @onclick="GenerateReport" disabled="@isGenerating" class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white transition text-sm font-medium disabled:opacity-50">
                            @(isGenerating ? "Генерация..." : "Сгенерировать")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (dashboard != null)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            @{
                var dealsWidget = dashboard.Widgets.FirstOrDefault(w => w.WidgetType == "deals_summary");
                var tasksWidget = dashboard.Widgets.FirstOrDefault(w => w.WidgetType == "tasks_summary");
                var clientsWidget = dashboard.Widgets.FirstOrDefault(w => w.WidgetType == "clients_summary");
            }

            @if (dealsWidget != null)
            {
                var data = ParseJson(dealsWidget.Config);
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 p-5">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-sm font-medium text-gray-500">Сделки</span>
                        <div class="w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.35c0 .621-.504 1.125-1.125 1.125H4.875c-.621 0-1.125-.504-1.125-1.125v-4.35m16.5 0V9.15m0 5.25H3.75m16.5 0H3.75m0 0V9.15m0 5.25c0-.621.504-1.125 1.125-1.125h16.5c.621 0 1.125.504 1.125 1.125V9.15m-18 0L5.25 3.75h13.5l2.25 5.4" />
                            </svg>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-gray-900">@data.GetValueOrDefault("totalDeals", 0)</p>
                    <p class="text-xs text-gray-400 mt-1">Общая сумма: @data.GetValueOrDefault("totalAmount", 0m) ₽</p>
                </div>
            }

            @if (tasksWidget != null)
            {
                var data = ParseJson(tasksWidget.Config);
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 p-5">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-sm font-medium text-gray-500">Задачи</span>
                        <div class="w-9 h-9 rounded-xl bg-amber-50 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-amber-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-2.485-.036H6.598a48.42 48.42 0 00-2.485.036c-1.131.094-1.976 1.057-1.976 2.192V16.5A2.25 2.25 0 004.5 18.75h3" />
                            </svg>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-gray-900">@data.GetValueOrDefault("totalTasks", 0)</p>
                    <p class="text-xs text-gray-400 mt-1">Завершено: @data.GetValueOrDefault("completedTasks", 0)</p>
                </div>
            }

            @if (clientsWidget != null)
            {
                var data = ParseJson(clientsWidget.Config);
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 p-5">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-sm font-medium text-gray-500">Клиенты</span>
                        <div class="w-9 h-9 rounded-xl bg-violet-50 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-violet-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                            </svg>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-gray-900">@data.GetValueOrDefault("totalClients", 0)</p>
                    <p class="text-xs text-gray-400 mt-1">Всего клиентов</p>
                </div>
            }

            <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 p-5">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-sm font-medium text-gray-500">Отчёты</span>
                    <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-emerald-600">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                        </svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900">@reports.Count</p>
                <p class="text-xs text-gray-400 mt-1">Сформировано</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            @foreach (var widget in dashboard.Widgets.Where(w => w.WidgetType != "deals_summary" && w.WidgetType != "tasks_summary" && w.WidgetType != "clients_summary").OrderBy(w => w.Position))
            {
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 p-5">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-9 h-9 rounded-xl bg-gray-50 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
                            </svg>
                        </div>
                        <h3 class="font-semibold text-gray-900 text-sm">@widget.Title</h3>
                    </div>
                    @if (widget.WidgetType == "recent_activities")
                    {
                        <div class="flex flex-col items-center justify-center py-6 text-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1" stroke="currentColor" class="w-8 h-8 text-gray-200 mb-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="text-sm text-gray-400">Нет последних действий</p>
                        </div>
                    }
                    else
                    {
                        <div class="bg-gray-50 rounded-xl p-4">
                            <pre class="text-xs text-gray-500 font-mono overflow-auto whitespace-pre-wrap">@widget.Config</pre>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (reports.Any())
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gray-50 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-500">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v2.625a2.625 2.625 0 01-2.625 2.625h-13.5A2.625 2.625 0 01.75 16.875V3.375A2.625 2.625 0 013.375.75h9.586c.696 0 1.364.277 1.857.77l3.162 3.162c.493.493.77 1.16.77 1.857v7.711z" />
                    </svg>
                </div>
                <h2 class="font-semibold text-gray-900">Сгенерированные отчёты</h2>
            </div>
            <div class="divide-y divide-gray-50">
                @foreach (var report in reports)
                {
                    <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50/50 transition">
                        <div class="flex items-center gap-4">
                            <div class="w-9 h-9 rounded-xl @GetReportTypeBg(report.Type) flex items-center justify-center flex-shrink-0">
                                @GetReportTypeIcon(report.Type)
                            </div>
                            <div>
                                <p class="font-medium text-gray-900 text-sm">@GetReportTypeName(report.Type)</p>
                                <p class="text-xs text-gray-400 mt-0.5 font-mono">@report.Parameters</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-gray-400">@report.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">Готов</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;

    private DashboardDto? dashboard;
    private List<ReportDto> reports = new();
    private bool showReportForm;
    private bool isGenerating;
    private string? reportError;

    private ReportFormModel reportForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        var userId = AuthState.User?.Id ?? Guid.Empty;
        if (userId != Guid.Empty)
        {
            dashboard = await Api.GetAsync<DashboardDto>($"/api/analytics/dashboard/{userId}");
        }
    }

    private void OpenReportForm()
    {
        reportForm = new ReportFormModel { Type = 1, Parameters = "{}" };
        reportError = null;
        showReportForm = true;
    }

    private void CloseReportForm() => showReportForm = false;

    private async Task GenerateReport()
    {
        isGenerating = true;
        reportError = null;
        try
        {
            var payload = new
            {
                Type = reportForm.Type,
                Parameters = string.IsNullOrWhiteSpace(reportForm.Parameters) ? "{}" : reportForm.Parameters
            };
            var result = await Api.PostAsync<ReportDto>("/api/analytics/reports", payload);
            if (result != null)
            {
                reports.Insert(0, result);
            }
            showReportForm = false;
        }
        catch (Exception)
        {
            reportError = "Ошибка при генерации отчёта";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private string GetReportTypeName(string type) => type switch
    {
        "Сделки" or "1" => "Сделки",
        "Клиенты" or "2" => "Клиенты",
        "Задачи" or "3" => "Задачи",
        _ => type
    };

    private string GetReportTypeBg(string type) => type switch
    {
        "Сделки" or "1" => "bg-blue-50",
        "Клиенты" or "2" => "bg-violet-50",
        "Задачи" or "3" => "bg-amber-50",
        _ => "bg-gray-50"
    };

    private MarkupString GetReportTypeIcon(string type)
    {
        var color = type switch
        {
            "Сделки" or "1" => "text-blue-600",
            "Клиенты" or "2" => "text-violet-600",
            "Задачи" or "3" => "text-amber-600",
            _ => "text-gray-500"
        };

        var svg = type switch
        {
            "Сделки" or "1" => $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M20.25 14.15v4.35c0 .621-.504 1.125-1.125 1.125H4.875c-.621 0-1.125-.504-1.125-1.125v-4.35m16.5 0V9.15m0 5.25H3.75m16.5 0H3.75m0 0V9.15m0 5.25c0-.621.504-1.125 1.125-1.125h16.5c.621 0 1.125.504 1.125 1.125V9.15m-18 0L5.25 3.75h13.5l2.25 5.4\" /></svg>",
            "Клиенты" or "2" => $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z\" /></svg>",
            "Задачи" or "3" => $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-2.485-.036H6.598a48.42 48.42 0 00-2.485.036c-1.131.094-1.976 1.057-1.976 2.192V16.5A2.25 2.25 0 004.5 18.75h3\" /></svg>",
            _ => $"<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-5 h-5 {color}\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.5 14.25v2.625a2.625 2.625 0 01-2.625 2.625h-13.5A2.625 2.625 0 01.75 16.875V3.375A2.625 2.625 0 013.375.75h9.586c.696 0 1.364.277 1.857.77l3.162 3.162c.493.493.77 1.16.77 1.857v7.711z\" /></svg>"
        };

        return new MarkupString(svg);
    }

    private Dictionary<string, object> ParseJson(string json)
    {
        try
        {
            var result = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
            return result ?? new Dictionary<string, object>();
        }
        catch { return new Dictionary<string, object>(); }
    }

    private class ReportFormModel
    {
        public int Type { get; set; } = 1;
        public string Parameters { get; set; } = "{}";
    }

    private record DashboardDto(Guid UserId, List<WidgetDto> Widgets);
    private record WidgetDto(Guid Id, string WidgetType, string Title, string Config, int Position);
    private record ReportDto(Guid Id, string Type, string Parameters, DateTime GeneratedAt, Guid GeneratedByUserId, string Data);
}
