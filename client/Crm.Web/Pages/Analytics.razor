@page "/analytics"
@using Crm.Web.Services
@using Crm.Web.Auth
@using System.Globalization
@using System.Text.Json

<PageTitle>Аналитика - CRM</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Аналитика</h1>
            <p class="text-sm text-slate-500 mt-1">Отчеты, динамика и состояние CRM</p>
        </div>
        <button
            @onclick="OpenReportForm"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 shadow-sm hover:shadow-md transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6m4 6V7m4 10v-4M5 19h14"/></svg>
            Сформировать отчет
        </button>
    </div>

    @if (loadError is not null)
    {
        <div class="rounded-lg border border-red-200 bg-red-50 text-red-700 px-4 py-3 text-sm">
            @loadError
        </div>
    }

    @if (isLoading)
    {
        <div class="text-gray-500 text-sm">Загрузка аналитики...</div>
    }
    else if (dashboard != null)
    {
        var deals = ParseDealsWidget();
        var tasks = ParseTasksWidget();
        var clients = ParseClientsWidget();
        var dealStageEntries = GetTopEntries(deals.ByStage, 6);
        var taskStatusEntries = GetTopEntries(tasks.ByStatus, 6);
        var clientStatusEntries = GetTopEntries(clients.ByStatus, 6);

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="analytics-kpi">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Сделки</p>
                    <span class="analytics-dot bg-blue-500"></span>
                </div>
                <p class="text-3xl font-bold text-slate-900 mt-2">@deals.TotalDeals.ToString("N0", CultureInfo.InvariantCulture)</p>
                <p class="text-sm text-slate-600 mt-3">Активные: @deals.ActiveDeals</p>
                <p class="text-sm text-slate-500">Выиграно / Проиграно: @deals.WonDeals / @deals.LostDeals</p>
            </div>
            <div class="analytics-kpi">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Задачи</p>
                    <span class="analytics-dot bg-emerald-500"></span>
                </div>
                <p class="text-3xl font-bold text-slate-900 mt-2">@tasks.TotalTasks.ToString("N0", CultureInfo.InvariantCulture)</p>
                <p class="text-sm text-slate-600 mt-3">Завершено: @tasks.CompletedTasks</p>
                <p class="text-sm text-slate-500">В работе: @tasks.PendingTasks / Просрочено: @tasks.OverdueTasks</p>
            </div>
            <div class="analytics-kpi">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Клиенты</p>
                    <span class="analytics-dot bg-amber-500"></span>
                </div>
                <p class="text-3xl font-bold text-slate-900 mt-2">@clients.TotalClients.ToString("N0", CultureInfo.InvariantCulture)</p>
                <p class="text-sm text-slate-600 mt-3">Новых за месяц: @clients.NewThisMonth</p>
                <p class="text-sm text-slate-500">Статусы воронки: @clients.ByStatus.Count</p>
            </div>
            <div class="analytics-kpi">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Сумма сделок</p>
                    <span class="analytics-dot bg-cyan-500"></span>
                </div>
                <p class="text-3xl font-bold text-slate-900 mt-2">@deals.TotalAmount.ToString("N0", CultureInfo.InvariantCulture) ₽</p>
                <p class="text-sm text-slate-600 mt-3">Открытая воронка</p>
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
            <div class="analytics-panel">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold text-slate-800">Этапы сделок</h2>
                    <span class="analytics-badge text-blue-700 bg-blue-50 ring-blue-100">динамика</span>
                </div>
                @if (dealStageEntries.Any())
                {
                    <div class="mt-4 space-y-3">
                        @for (var index = 0; index < dealStageEntries.Count; index++)
                        {
                            var item = dealStageEntries[index];
                            <div>
                                <div class="flex justify-between text-sm text-slate-700 mb-1">
                                    <span>@FormatDataLabel(item.Key)</span>
                                    <span>@item.Value</span>
                                </div>
                                <div class="chart-bar-shell">
                                    <div class="chart-bar-fill"
                                         style="--bar-percent: @GetBarPercent(item.Value, deals.StageMax)%; --bar-delay: @(index * 70)ms; --bar-color: @GetChartColor(index);">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500 mt-4">По сделкам пока нет данных.</p>
                }
            </div>

            <div class="analytics-panel">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold text-slate-800">Динамика сделок</h2>
                    <span class="analytics-badge text-slate-600 bg-slate-50 ring-slate-100">тренд</span>
                </div>
                @if (deals.ByMonth.Any())
                {
                    <svg viewBox="0 0 420 140" class="sparkline-chart mt-3">
                        <defs>
                            <linearGradient id="deals-gradient" x1="0" x2="1">
                                <stop offset="0%" stop-color="#2563eb" />
                                <stop offset="100%" stop-color="#06b6d4" />
                            </linearGradient>
                        </defs>
                        <rect x="0" y="0" width="420" height="140" fill="none" />
                        <line x1="12" y1="120" x2="408" y2="120" class="sparkline-grid" />
                        <polyline
                            class="sparkline-line"
                            points="@BuildSparklinePoints(deals.ByMonth, 420, 140)"
                            style="--line-color: #2563eb; --line-delay: 120ms">
                        </polyline>
                        @foreach (var p in BuildSparklinePointsWithIndex(deals.ByMonth, 420, 140))
                        {
                            <circle cx="@p.X.ToString("0.##", CultureInfo.InvariantCulture)"
                                    cy="@p.Y.ToString("0.##", CultureInfo.InvariantCulture)"
                                    r="2.6"
                                    fill="#fff"
                                    stroke="#2563eb"
                                    stroke-width="2" />
                        }
                    </svg>
                    <div class="mt-2 text-xs text-gray-500">Создание сделок по дням, неделям или месяцам</div>
                }
                else
                {
                    <p class="text-sm text-gray-500 mt-4">По месяцам данных не найдено.</p>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
            <div class="analytics-panel">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold text-slate-800">Задачи по статусам</h2>
                    <span class="analytics-badge text-emerald-700 bg-emerald-50 ring-emerald-100">в работе</span>
                </div>
                @if (taskStatusEntries.Any())
                {
                    <div class="mt-4 space-y-3">
                        @for (var index = 0; index < taskStatusEntries.Count; index++)
                        {
                            var item = taskStatusEntries[index];
                            <div>
                                <div class="flex justify-between text-sm text-slate-700 mb-1">
                                    <span>@FormatDataLabel(item.Key)</span>
                                    <span>@item.Value</span>
                                </div>
                                <div class="chart-bar-shell">
                                    <div class="chart-bar-fill"
                                         style="--bar-percent: @GetBarPercent(item.Value, tasks.StatusMax)%; --bar-delay: @(index * 70)ms; --bar-color: @GetChartColor(index + 3);">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500 mt-4">По задачам пока нет статусов.</p>
                }
            </div>

            <div class="analytics-panel">
                <div class="flex items-center justify-between">
                    <h2 class="font-semibold text-slate-800">Клиенты по статусам</h2>
                    <span class="analytics-badge text-amber-700 bg-amber-50 ring-amber-100">воронка</span>
                </div>
                @if (clientStatusEntries.Any())
                {
                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                        @for (var index = 0; index < clientStatusEntries.Count; index++)
                        {
                            var item = clientStatusEntries[index];
                            <div class="rounded-xl ring-1 ring-slate-100 px-3 py-2 bg-slate-50/70">
                                <div class="text-xs text-gray-500">@FormatDataLabel(item.Key)</div>
                                <div class="mt-1 text-lg font-semibold text-gray-900">@item.Value</div>
                                <div class="mt-2 chart-bar-shell">
                                    <div class="chart-bar-fill"
                                         style="--bar-percent: @GetBarPercent(item.Value, clientStatusEntries.Count == 0 ? 1 : clientStatusEntries.Max(x => x.Value))%; --bar-delay: @(index * 70)ms; --bar-color: @GetChartColor(index + 6);">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500 mt-4">По статусам клиентов пока нет данных.</p>
                }
            </div>
        </div>
    }

    <div class="analytics-panel">
        <div class="flex items-center justify-between">
            <h2 class="font-semibold text-slate-800">История отчетов</h2>
            <span class="analytics-badge text-slate-600 bg-slate-50 ring-slate-100">последние 20</span>
        </div>
        @if (isLoadingReports)
        {
            <p class="text-sm text-gray-500 mt-4">Загрузка отчетов...</p>
        }
        else
        {
            var visibleReports = reports.Where(report => !hiddenReportIds.Contains(report.Id)).ToList();
            if (!visibleReports.Any())
            {
                <p class="text-sm text-gray-500 mt-4">Пока нет отчетов для показа.</p>
            }
            else
            {
                <div class="mt-4 space-y-3">
                @foreach (var report in visibleReports)
                {
                    var periodText = FormatParametersPeriod(report.Parameters);
                    var isExpanded = expandedReportIds.Contains(report.Id);
                    <div class="rounded-xl ring-1 ring-slate-100 bg-white px-4 py-3 hover:ring-slate-200 transition">
                        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                            <div>
                                <p class="font-medium text-gray-900">@GetReportTypeLabel(report.Type)</p>
                                <p class="text-sm text-gray-500">Период: @periodText</p>
                                <p class="text-sm text-gray-600 mt-1">@GetReportSummaryLine(report)</p>
                                <p class="text-xs text-gray-400 mt-1">@report.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button
                                    type="button"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50 transition"
                                    @onclick="() => ToggleReportDetails(report.Id)">
                                    <svg class="w-3.5 h-3.5 transition-transform @(isExpanded ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"/></svg>
                                    @(isExpanded ? "Свернуть" : "Открыть")
                                </button>
                                <button
                                    type="button"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-500 hover:text-red-700 hover:bg-red-50 transition"
                                    @onclick="() => RemoveReportFromView(report.Id)">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12m-9 4v6m6-6v6M9 7l1-2h4l1 2m-8 0 1 13h8l1-13"/></svg>
                                    Убрать
                                </button>
                            </div>
                        </div>

                        @if (isExpanded)
                        {
                            <div class="mt-3 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_260px] gap-3">
                                <div class="rounded-lg bg-slate-50 ring-1 ring-slate-100 p-3">
                                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">График отчета</div>
                                    @{
                                        var chartEntries = GetReportChartEntries(report);
                                    }
                                    @if (report.Type == "1" && ParseDealsReport(report.Data).ByMonth.Count > 1)
                                    {
                                        var data = ParseDealsReport(report.Data);
                                        <svg viewBox="0 0 360 120" class="sparkline-chart">
                                            <line x1="12" y1="100" x2="348" y2="100" class="sparkline-grid" />
                                            <polyline
                                                class="sparkline-line"
                                                points="@BuildSparklinePoints(data.ByMonth, 360, 120)"
                                                style="--line-color: #0f766e; --line-delay: 0ms">
                                            </polyline>
                                            @foreach (var p in BuildSparklinePointsWithIndex(data.ByMonth, 360, 120))
                                            {
                                                <circle cx="@p.X.ToString("0.##", CultureInfo.InvariantCulture)"
                                                        cy="@p.Y.ToString("0.##", CultureInfo.InvariantCulture)"
                                                        r="2.6"
                                                        fill="#fff"
                                                        stroke="#0f766e"
                                                        stroke-width="2" />
                                            }
                                        </svg>
                                    }
                                    else if (chartEntries.Any())
                                    {
                                        <div class="space-y-2">
                                            @for (var index = 0; index < chartEntries.Count; index++)
                                            {
                                                var item = chartEntries[index];
                                                var max = Math.Max(1, chartEntries.Max(x => x.Value));
                                                <div>
                                                    <div class="flex justify-between text-xs text-slate-600 mb-1">
                                                        <span>@FormatDataLabel(item.Key)</span>
                                                        <span>@item.Value</span>
                                                    </div>
                                                    <div class="chart-bar-shell">
                                                        <div class="chart-bar-fill"
                                                             style="--bar-percent: @GetBarPercent(item.Value, max)%; --bar-delay: @(index * 60)ms; --bar-color: @GetChartColor(index);">
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-slate-500">Для этого отчета пока нет данных для графика.</p>
                                    }
                                </div>
                                <div class="rounded-lg bg-white ring-1 ring-slate-100 px-3 py-2">
                                    @if (report.Type == "1")
                                    {
                                        var data = ParseDealsReport(report.Data);
                                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-700">
                                            <div>Всего: <span class="font-semibold text-slate-900">@data.TotalDeals</span></div>
                                            <div>Выиграно: <span class="font-semibold text-slate-900">@data.WonDeals</span></div>
                                            <div>Активно: <span class="font-semibold text-slate-900">@data.ActiveDeals</span></div>
                                            <div>Сумма: <span class="font-semibold text-slate-900">@data.TotalAmount.ToString("N0", CultureInfo.InvariantCulture) ₽</span></div>
                                        </div>
                                    }
                                    else if (report.Type == "2")
                                    {
                                        var data = ParseClientsReport(report.Data);
                                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-700">
                                            <div>Всего: <span class="font-semibold text-slate-900">@data.TotalClients</span></div>
                                            <div>Новых: <span class="font-semibold text-slate-900">@data.NewClients</span></div>
                                        </div>
                                    }
                                    else
                                    {
                                        var data = ParseTasksReport(report.Data);
                                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-700">
                                            <div>Всего: <span class="font-semibold text-slate-900">@data.TotalTasks</span></div>
                                            <div>Выполнено: <span class="font-semibold text-slate-900">@data.CompletedTasks</span></div>
                                            <div>В работе: <span class="font-semibold text-slate-900">@data.PendingTasks</span></div>
                                            <div>Просрочено: <span class="font-semibold text-slate-900">@data.OverdueTasks</span></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                </div>
            }
        }
    </div>

    @if (showReportForm)
    {
        <div
            class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 z-40"
            @onclick="CloseReportForm">
            <div class="bg-white rounded-xl shadow-lg w-full max-w-md p-5" @onclick:stopPropagation>
                <h2 class="text-lg font-semibold mb-4">Сформировать отчет</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm text-gray-700 mb-1">Тип отчета</label>
                        <select @bind="reportForm.Type" class="w-full border rounded-lg px-3 py-2 text-sm">
                            <option value="1">Сделки</option>
                            <option value="2">Клиенты</option>
                            <option value="3">Задачи</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm text-gray-700 mb-1">Период</label>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" class="px-3 py-1.5 text-xs rounded-lg ring-1 ring-slate-200 hover:bg-slate-50 @GetPresetButtonClass(6)" @onclick='() => ApplyPeriodPreset(6)'>7 дней</button>
                            <button type="button" class="px-3 py-1.5 text-xs rounded-lg ring-1 ring-slate-200 hover:bg-slate-50 @GetPresetButtonClass(29)" @onclick='() => ApplyPeriodPreset(29)'>30 дней</button>
                            <button type="button" class="px-3 py-1.5 text-xs rounded-lg ring-1 ring-slate-200 hover:bg-slate-50 @GetPresetButtonClass(89)" @onclick='() => ApplyPeriodPreset(89)'>90 дней</button>
                            <button type="button" class="px-3 py-1.5 text-xs rounded-lg ring-1 ring-slate-200 hover:bg-slate-50 @GetPresetButtonClass(364)" @onclick='() => ApplyPeriodPreset(364)'>Год</button>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm text-gray-700 mb-1">С</label>
                            <input type="date" class="w-full border rounded-lg px-3 py-2 text-sm" @bind="reportForm.From" />
                        </div>
                        <div>
                            <label class="block text-sm text-gray-700 mb-1">По</label>
                            <input type="date" class="w-full border rounded-lg px-3 py-2 text-sm" @bind="reportForm.To" />
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(reportError))
                    {
                        <div class="text-sm text-red-600">@reportError</div>
                    }

                    <div class="flex justify-end gap-3 mt-1">
                        <button class="px-4 py-2 text-sm rounded-lg border" @onclick="CloseReportForm">Отмена</button>
                        <button class="px-4 py-2 text-sm rounded-lg bg-blue-600 text-white disabled:opacity-70" disabled="@isGenerating" @onclick="GenerateReport">
                            @((isGenerating) ? "Готовим..." : "Сформировать")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .analytics-kpi,
    .analytics-panel {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        border: 1px solid rgba(226, 232, 240, 0.9);
    }

    .analytics-kpi {
        padding: 20px;
    }

    .analytics-panel {
        padding: 20px;
    }

    .analytics-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        box-shadow: 0 0 0 4px rgba(148, 163, 184, 0.12);
    }

    .analytics-badge {
        border-radius: 999px;
        padding: 4px 8px;
        font-size: 12px;
        line-height: 16px;
        box-shadow: inset 0 0 0 1px currentColor;
        opacity: 0.9;
    }

    .chart-bar-shell {
        height: 10px;
        border-radius: 999px;
        background: #f1f5f9;
        overflow: hidden;
    }

    .chart-bar-fill {
        height: 100%;
        border-radius: inherit;
        width: var(--bar-percent);
        background: var(--bar-color);
        transform: scaleX(0);
        transform-origin: left;
        animation: chart-bar-grow 0.8s ease-out forwards;
        animation-delay: var(--bar-delay);
    }

    @@keyframes chart-bar-grow {
        to {
            transform: scaleX(1);
        }
    }

    .sparkline-chart {
        display: block;
        width: 100%;
        height: 170px;
        overflow: visible;
    }

    .sparkline-grid {
        stroke: #e2e8f0;
        stroke-width: 1;
        stroke-dasharray: 4 5;
    }

    .sparkline-line {
        fill: none;
        stroke: var(--line-color, #2563eb);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
        animation: sparkline-emerge 0.7s ease-out both;
        animation-delay: var(--line-delay, 0ms);
    }

    @@keyframes sparkline-emerge {
        from {
            opacity: 0.45;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;

    private DashboardDto? dashboard;
    private List<ReportDto> reports = new();
    private HashSet<Guid> expandedReportIds = new();
    private HashSet<Guid> hiddenReportIds = new();
    private bool isLoading = true;
    private bool isLoadingReports = true;
    private bool isGenerating;
    private bool showReportForm;
    private string? loadError;
    private string? reportError;
    private int? selectedPresetDays = 29;

    private ReportFormModel reportForm = new();

    private static readonly string[] ChartColorPalette =
    {
        "#2563EB", "#0EA5E9", "#14B8A6", "#8B5CF6", "#F59E0B",
        "#22C55E", "#F97316", "#EF4444", "#06B6D4"
    };

    protected override async Task OnInitializedAsync()
    {
        reportForm = new ReportFormModel
        {
            Type = 1,
            From = DateTime.Today.AddDays(-30),
            To = DateTime.Today
        };

        await LoadPageDataAsync();
    }

    private async Task LoadPageDataAsync()
    {
        var userId = AuthState.User?.Id ?? Guid.Empty;
        if (userId == Guid.Empty)
        {
            loadError = "Пользователь не авторизован.";
            isLoading = false;
            isLoadingReports = false;
            return;
        }

        try
        {
            var dashboardTask = LoadDashboardAsync(userId);
            var reportsTask = LoadReportsAsync();
            await Task.WhenAll(dashboardTask, reportsTask);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
            isLoadingReports = false;
        }
    }

    private async Task LoadDashboardAsync(Guid userId)
    {
        dashboard = await Api.GetAsync<DashboardDto>($"/api/analytics/dashboard/{userId}");
    }

    private async Task LoadReportsAsync()
    {
        var result = await Api.GetAsync<List<ReportDto>>("/api/analytics/reports?take=20");
        if (result is not null)
        {
            reports = result.ToList();
        }
    }

    private void OpenReportForm()
    {
        showReportForm = true;
        reportError = null;
    }

    private void CloseReportForm()
    {
        showReportForm = false;
    }

    private void ToggleReportDetails(Guid reportId)
    {
        if (!expandedReportIds.Add(reportId))
        {
            expandedReportIds.Remove(reportId);
        }
    }

    private void RemoveReportFromView(Guid reportId)
    {
        hiddenReportIds.Add(reportId);
        expandedReportIds.Remove(reportId);
    }

    private void ApplyPeriodPreset(int daysBack)
    {
        selectedPresetDays = daysBack;
        reportForm.From = DateTime.Today.AddDays(-daysBack);
        reportForm.To = DateTime.Today;
    }

    private string GetPresetButtonClass(int days)
    {
        return selectedPresetDays == days
            ? "bg-blue-600 text-white ring-blue-600 hover:bg-blue-700"
            : "text-gray-700";
    }

    private async Task GenerateReport()
    {
        isGenerating = true;
        reportError = null;

        try
        {
            var from = reportForm.From.Date;
            var to = reportForm.To.Date.AddDays(1).AddTicks(-1);
            if (from > to)
            {
                (from, to) = (to, from);
            }

            var parameters = BuildParametersJson(from, to);

            var payload = new
            {
                Type = reportForm.Type,
                Parameters = parameters
            };

            var result = await Api.PostAsync<ReportDto>("/api/analytics/reports", payload);
            if (result != null)
            {
                reports.Insert(0, result);
                expandedReportIds.Add(result.Id);
                hiddenReportIds.Remove(result.Id);
            }

            CloseReportForm();
        }
        catch (Exception ex)
        {
            reportError = ex.Message;
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

