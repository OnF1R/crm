@page "/notifications"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Уведомления - CRM</PageTitle>

<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Уведомления</h1>
                <p class="text-sm text-gray-400 mt-0.5">Оповещения и сообщения</p>
            </div>
            @if (notifications.Any(n => n.Status == "1" || n.Status == "Непрочитано"))
            {
                var unread = notifications.Count(n => n.Status == "1" || n.Status == "Непрочитано");
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                    @unread
                </span>
            }
        </div>
        <div class="flex items-center gap-3">
            @if (notifications.Any(n => n.Status == "1" || n.Status == "Непрочитано"))
            {
                <button @onclick="MarkAllRead" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gray-100 text-gray-700 hover:bg-gray-200 transition text-sm font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2.25 2.25L15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Прочитать все
                </button>
            }
            <button @onclick="OpenForm" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5.25v13.5M18.75 12h-13.5" />
                </svg>
                Создать
            </button>
        </div>
    </div>

    @if (showForm)
    {
        <div class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center z-50" @onclick="CloseForm">
            <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-lg" @onclick:stopPropagation>
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="block w-5 h-5 text-blue-600">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022 23.848 23.848 0 005.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                        </svg>
                    </div>
                    <h2 class="text-lg font-bold text-gray-900">Новое уведомление</h2>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Заголовок *</label>
                        <input @bind="form.Title" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition text-sm" placeholder="Заголовок уведомления" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Сообщение *</label>
                        <textarea @bind="form.Message" rows="3" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition text-sm resize-none" placeholder="Текст уведомления"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Тип</label>
                        <select @bind="form.Type" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition text-sm bg-white">
                            <option value="1">В приложении</option>
                            <option value="2">Email</option>
                            <option value="3">Push</option>
                        </select>
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="flex items-center gap-2 p-3 bg-red-50 border border-red-100 rounded-xl text-red-700 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 flex-shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                            </svg>
                            @formError
                        </div>
                    }
                    <div class="flex justify-end gap-3 pt-2">
                        <button @onclick="CloseForm" class="px-4 py-2.5 rounded-xl bg-gray-100 text-gray-700 hover:bg-gray-200 transition text-sm font-medium">Отмена</button>
                        <button @onclick="CreateNotification" disabled="@isSubmitting" class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white transition text-sm font-medium disabled:opacity-50">
                            @(isSubmitting ? "Создание..." : "Создать")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="bg-white rounded-2xl shadow-sm p-12 text-center">
            <div class="inline-flex items-center gap-2 text-gray-400">
                <svg class="animate-spin w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Загрузка уведомлений...
            </div>
        </div>
    }
    else if (notifications.Any())
    {
        <div class="space-y-3">
            @foreach (var n in notifications)
            {
                var isUnread = n.Status == "1" || n.Status == "Непрочитано";
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition @(isUnread ? "border-l-4 border-l-blue-500 bg-blue-50/20" : "") border border-gray-100 p-5 flex items-start justify-between gap-4">
                    <div class="flex items-start gap-4 flex-1 min-w-0">
                        <div class="w-10 h-10 rounded-xl @(isUnread ? "bg-blue-100" : "bg-gray-100") flex items-center justify-center flex-shrink-0 mt-0.5">
                            @if (isUnread)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="block w-5 h-5 text-blue-600">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022 23.848 23.848 0 005.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="block w-5 h-5 text-gray-400">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022 23.848 23.848 0 005.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                                </svg>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-semibold text-gray-900 text-sm">@n.Title</h3>
                                <span class="px-2 py-0.5 rounded-full text-xs font-medium @GetTypeColor(n.Type)">@GetTypeName(n.Type)</span>
                            </div>
                            <p class="text-sm text-gray-500 mt-1 line-clamp-2">@n.Message</p>
                            <p class="text-xs text-gray-400 mt-2">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        @if (isUnread)
                        {
                            <button @onclick="() => MarkAsRead(n.Id)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition text-xs font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2.25 2.25L15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Прочитать
                            </button>
                        }
                        <button @onclick="() => DeleteNotification(n.Id)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition text-xs font-medium">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-16 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 80 80" stroke-width="1" stroke="currentColor" class="w-20 h-20 text-gray-200 mx-auto mb-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M49.523 56.94c6.25-.86 12.268-2.297 18.015-4.368-6.174-6.641-9.58-15.336-9.538-24.397V27.5C58 17.835 50.165 10 40.5 10S23 17.835 23 27.5v.675c.042 9.061-3.364 17.756-9.538 24.397 5.747 2.071 11.765 3.508 18.015 4.368m18.046 0a73.927 73.927 0 01-18.046 0m18.046 0a9.5 9.5 0 11-18.046 0" />
                <circle cx="40" cy="40" r="28" stroke-dasharray="4 3" />
            </svg>
            <h3 class="text-gray-900 font-semibold mb-1">Нет уведомлений</h3>
            <p class="text-sm text-gray-400">У вас нет непрочитанных сообщений</p>
        </div>
    }
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;

    private List<NotificationDto> notifications = new();
    private bool isLoading = true;
    private bool showForm;
    private bool isSubmitting;
    private string? formError;

    private NotificationForm form = new();

    protected override async Task OnInitializedAsync() => await LoadNotifications();

    private async Task LoadNotifications()
    {
        isLoading = true;
        var userId = AuthState.User?.Id ?? Guid.Empty;
        if (userId != Guid.Empty)
        {
            var result = await Api.GetAsync<PagedResult<NotificationDto>>($"/api/notifications/users/{userId}/notifications");
            if (result != null) notifications = result.Items.ToList();
        }
        isLoading = false;
        StateHasChanged();
    }

    private void OpenForm()
    {
        form = new NotificationForm { Type = 1 };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task CreateNotification()
    {
        if (string.IsNullOrWhiteSpace(form.Title) || string.IsNullOrWhiteSpace(form.Message))
        {
            formError = "Заголовок и сообщение обязательны";
            return;
        }

        isSubmitting = true;
        formError = null;
        try
        {
            var payload = new
            {
                UserId = AuthState.User?.Id ?? Guid.Empty,
                Type = form.Type,
                Title = form.Title,
                Message = form.Message
            };
            await Api.PostAsync<NotificationDto>("/api/notifications/notifications", payload);
            showForm = false;
            await LoadNotifications();
        }
        catch (Exception)
        {
            formError = "Ошибка при создании уведомления";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task MarkAsRead(Guid id)
    {
        await Api.PutAsync<NotificationDto>($"/api/notifications/notifications/{id}/read", new { });
        await LoadNotifications();
    }

    private async Task MarkAllRead()
    {
        foreach (var n in notifications.Where(x => x.Status == "1" || x.Status == "Непрочитано").ToList())
        {
            await Api.PutAsync<NotificationDto>($"/api/notifications/notifications/{n.Id}/read", new { });
        }
        await LoadNotifications();
    }

    private async Task DeleteNotification(Guid id)
    {
        await Api.DeleteAsync($"/api/notifications/notifications/{id}");
        await LoadNotifications();
    }

    private string GetTypeName(string type) => type switch
    {
        "InApp" or "1" => "В приложении",
        "Email" or "2" => "Email",
        "Push" or "3" => "Push",
        _ => type
    };

    private string GetTypeColor(string type) => type switch
    {
        "InApp" or "1" => "bg-blue-100 text-blue-700",
        "Email" or "2" => "bg-emerald-100 text-emerald-700",
        "Push" or "3" => "bg-violet-100 text-violet-700",
        _ => "bg-gray-100 text-gray-600"
    };

    private class NotificationForm
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public int Type { get; set; } = 1;
    }

    private record NotificationDto(Guid Id, Guid UserId, string Type, string Title, string Message, string Status, string? RelatedEntityType, Guid? RelatedEntityId, DateTime CreatedAt);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}

