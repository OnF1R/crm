@page "/notifications"
@using Crm.Web.Services
@using Crm.Web.Auth

<PageTitle>Уведомления - CRM</PageTitle>

<div>
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Уведомления</h1>
            <p class="text-gray-500">Ваши уведомления и оповещения</p>
        </div>
        <div class="flex gap-3">
            @if (notifications.Any(n => n.Status == "1" || n.Status == "Непрочитано"))
            {
                <button @onclick="MarkAllRead" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition text-sm">
                    Прочитать все
                </button>
            }
            <button @onclick="OpenForm" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition">
                + Создать
            </button>
        </div>
    </div>

    @if (showForm)
    {
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" @onclick="CloseForm">
            <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-lg" @onclick:stopPropagation>
                <h2 class="text-lg font-bold text-gray-900 mb-4">Новое уведомление</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Заголовок *</label>
                        <input @bind="form.Title" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Заголовок уведомления" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Сообщение *</label>
                        <textarea @bind="form.Message" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Текст уведомления"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Тип</label>
                        <select @bind="form.Type" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="1">В приложении</option>
                            <option value="2">Email</option>
                            <option value="3">Push</option>
                        </select>
                    </div>
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">@formError</div>
                    }
                    <div class="flex justify-end gap-3 pt-2">
                        <button @onclick="CloseForm" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Отмена</button>
                        <button @onclick="CreateNotification" disabled="@isSubmitting" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition disabled:opacity-50">
                            @(isSubmitting ? "Создание..." : "Создать")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-gray-100">
            <p class="text-gray-400">Загрузка...</p>
        </div>
    }
    else if (notifications.Any())
    {
        <div class="space-y-3">
            @foreach (var n in notifications)
            {
                var isUnread = n.Status == "1" || n.Status == "Непрочитано";
                <div class="bg-white rounded-xl shadow-sm border @(isUnread ? "border-blue-200 bg-blue-50/30" : "border-gray-100") p-5 flex items-start justify-between">
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            @if (isUnread)
                            {
                                <span class="w-2 h-2 bg-blue-500 rounded-full flex-shrink-0"></span>
                            }
                            <h3 class="font-medium text-gray-900">@n.Title</h3>
                            <span class="px-2 py-0.5 text-xs rounded-full @GetTypeColor(n.Type)">@GetTypeName(n.Type)</span>
                        </div>
                        <p class="text-sm text-gray-600 mt-1">@n.Message</p>
                        <p class="text-xs text-gray-400 mt-2">@n.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                    </div>
                    <div class="flex items-center gap-2 ml-4 flex-shrink-0">
                        @if (isUnread)
                        {
                            <button @onclick="() => MarkAsRead(n.Id)" class="text-blue-600 hover:text-blue-800 text-sm">Прочитать</button>
                        }
                        <button @onclick="() => DeleteNotification(n.Id)" class="text-red-500 hover:text-red-700 text-sm">Удалить</button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-gray-100">
            <p class="text-gray-400 text-lg">Нет уведомлений</p>
        </div>
    }
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthState AuthState { get; set; } = default!;

    private List<NotificationDto> notifications = new();
    private bool isLoading = true;
    private bool showForm;
    private bool isSubmitting;
    private string? formError;

    private NotificationForm form = new();

    protected override async Task OnInitializedAsync() => await LoadNotifications();

    private async Task LoadNotifications()
    {
        isLoading = true;
        var userId = AuthState.User?.Id ?? Guid.Empty;
        if (userId != Guid.Empty)
        {
            var result = await Api.GetAsync<PagedResult<NotificationDto>>($"/api/notifications/users/{userId}/notifications");
            if (result != null) notifications = result.Items.ToList();
        }
        isLoading = false;
        StateHasChanged();
    }

    private void OpenForm()
    {
        form = new NotificationForm { Type = 1 };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task CreateNotification()
    {
        if (string.IsNullOrWhiteSpace(form.Title) || string.IsNullOrWhiteSpace(form.Message))
        {
            formError = "Заголовок и сообщение обязательны";
            return;
        }

        isSubmitting = true;
        formError = null;
        try
        {
            var payload = new
            {
                UserId = AuthState.User?.Id ?? Guid.Empty,
                Type = form.Type,
                Title = form.Title,
                Message = form.Message
            };
            await Api.PostAsync<NotificationDto>("/api/notifications/notifications", payload);
            showForm = false;
            await LoadNotifications();
        }
        catch (Exception)
        {
            formError = "Ошибка при создании уведомления";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task MarkAsRead(Guid id)
    {
        await Api.PutAsync<NotificationDto>($"/api/notifications/notifications/{id}/read", new { });
        await LoadNotifications();
    }

    private async Task MarkAllRead()
    {
        foreach (var n in notifications.Where(x => x.Status == "1" || x.Status == "Непрочитано").ToList())
        {
            await Api.PutAsync<NotificationDto>($"/api/notifications/notifications/{n.Id}/read", new { });
        }
        await LoadNotifications();
    }

    private async Task DeleteNotification(Guid id)
    {
        await Api.DeleteAsync($"/api/notifications/notifications/{id}");
        await LoadNotifications();
    }

    private string GetTypeName(string type) => type switch
    {
        "InApp" or "1" => "В приложении",
        "Email" or "2" => "Email",
        "Push" or "3" => "Push",
        _ => type
    };

    private string GetTypeColor(string type) => type switch
    {
        "InApp" or "1" => "bg-blue-100 text-blue-700",
        "Email" or "2" => "bg-green-100 text-green-700",
        "Push" or "3" => "bg-purple-100 text-purple-700",
        _ => "bg-gray-100 text-gray-600"
    };

    private class NotificationForm
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public int Type { get; set; } = 1;
    }

    private record NotificationDto(Guid Id, Guid UserId, string Type, string Title, string Message, string Status, string? RelatedEntityType, Guid? RelatedEntityId, DateTime CreatedAt);
    private record PagedResult<T>(List<T> Items, int TotalCount, int Page, int PageSize);
}
