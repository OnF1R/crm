{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "super_secret_jwt_key_at_least_32_chars_long",
    "Issuer": "Crm.Gateway",
    "Audience": "Crm.Web"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "clients-route": {
        "ClusterId": "clients-cluster",
        "Match": { "Path": "/api/clients/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "deals-route": {
        "ClusterId": "deals-cluster",
        "Match": { "Path": "/api/deals/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "tasks-route": {
        "ClusterId": "tasks-cluster",
        "Match": { "Path": "/api/tasks/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "documents-route": {
        "ClusterId": "documents-cluster",
        "Match": { "Path": "/api/documents/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": { "Path": "/api/analytics/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination": { "Address": "http://identity:8080" }
        }
      },
      "clients-cluster": {
        "Destinations": {
          "destination": { "Address": "http://clients:8080" }
        }
      },
      "deals-cluster": {
        "Destinations": {
          "destination": { "Address": "http://deals:8080" }
        }
      },
      "tasks-cluster": {
        "Destinations": {
          "destination": { "Address": "http://tasks:8080" }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "destination": { "Address": "http://notifications:8080" }
        }
      },
      "documents-cluster": {
        "Destinations": {
          "destination": { "Address": "http://documents:8080" }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "destination": { "Address": "http://analytics:8080" }
        }
      }
    }
  }
}
